{
  "id": "md.numen.readers.epub",
  "name": "EPUB Book Reader",
  "version": "2026.10.6",
  "protocol": 1,
  "description": "EPUB book reader with highlights and passage links",
  "capabilities": [],
  "targets": ["desktop.editor"],
  "contributes": {
    "tabKinds": [{ "kind": "reader:reader-epub", "title": "EPUB Reader", "icon": "book-open" }],
    "fileTypes": [{ "tabKind": "reader:reader-epub", "extensions": ["epub"] }],
    "feature": "EPUB books",
    "category": "readers",
    "handles": [{ "purpose": "text-provider", "contentTypes": ["application/epub+zip"] }],
    "readers": [
      { "id": "reader-epub", "contentTypes": ["application/epub+zip"], "rank": "default" }
    ]
  },
  "activationEvents": [],
  "permissions": ["vault:read", "vault:write"],
  "services": ["numen.epub"],
  "backend": {
    "type": "process",
    "entrypoint": "bin/readers-epub",
    "serviceName": "numen.epub"
  },
  "frontend": {
    "entrypoint": "dist/index.js",
    "styles": "dist/styles.css"
  }
}
