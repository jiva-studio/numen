{
  "id": "md.numen.readers.epub",
  "name": "EPUB Book Reader",
  "version": "1.0.0",
  "protocol": 1,
  "description": "EPUB book reader and metadata parser",
  "capabilities": [],
  "targets": ["desktop.editor"],
  "activationEvents": [],
  "permissions": ["vault:read", "vault:write"],
  "readers": [{ "id": "reader-epub", "contentTypes": ["application/epub+zip"], "rank": "default" }],
  "textInput": {
    "contentTypes": ["application/epub+zip"],
    "autoRun": true
  },
  "lifecycle": {
    "idleTimeoutSeconds": 300,
    "keepAliveWhileVisible": true,
    "memoryLimitBytes": 2147483648
  },
  "backend": {
    "type": "process",
    "entrypoint": "bin/readers-epub",
    "serviceName": "numen.epub.v1.BookService"
  },
  "frontend": {
    "entrypoint": "dist/index.js",
    "styles": "dist/styles.css"
  }
}
