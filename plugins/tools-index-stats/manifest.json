{
  "id": "md.numen.tools.index.stats",
  "name": "Index stats",
  "version": "2026.11.12",
  "protocol": 1,
  "description": "Shows in the title bar how many vectors the search index holds",
  "targets": ["desktop.editor"],
  "contributes": {
    "category": "tools",
    "slots": [
      { "slot": "titleBar.status", "view": "stats", "order": 10, "when": "window.isVaultOpen" }
    ]
  },
  "permissions": ["index:read", "vault:read"],
  "services": ["md.numen.tools.index.stats"],
  "backend": { "entrypoint": "bin/tools-index-stats" },
  "frontend": {}
}
