{
  "id": "md.numen.views.plex.headings.dropdown",
  "name": "Plex Headings Dropdown",
  "version": "2026.11.3",
  "protocol": 1,
  "description": "The headings of a note, listed under its node in the plex while the pointer rests on it",
  "capabilities": [],
  "targets": ["desktop.editor"],
  "contributes": {
    "feature": "plex headings dropdown",
    "category": "views",
    "slots": [{ "slot": "plexGraph.node", "view": "headings", "title": "Headings list" }]
  },
  "permissions": ["vault:read"],
  "settings": [
    {
      "key": "headingLimit",
      "type": "range",
      "title": "Headings per note",
      "description": "Most headings shown under a node",
      "default": 6,
      "min": 1,
      "max": 12,
      "step": 1
    }
  ],
  "frontend": {}
}
