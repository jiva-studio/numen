{
  "id": "md.numen.readers.pdf",
  "name": "PDF Reader",
  "version": "2026.11.15",
  "protocol": 1,
  "description": "PDF document reader with highlights and passage links",
  "capabilities": [],
  "targets": ["desktop.editor"],
  "contributes": {
    "textKinds": [{ "kind": "page-text", "title": "Text layer" }],
    "tabKinds": [
      {
        "kind": "reader:reader-pdf",
        "title": "PDF Reader",
        "icon": "file-text"
      }
    ],
    "feature": "PDF documents",
    "category": "readers",
    "readers": [
      {
        "id": "reader-pdf",
        "contentTypes": ["application/pdf"],
        "rank": "default"
      }
    ],
    "slots": [
      {
        "slot": "fileTree.context",
        "command": "app:file.createText",
        "group": "3-text",
        "order": 10
      }
    ],
    "handlers": [
      {
        "command": "app:file.createText",
        "title": "Extract text layer",
        "when": "target.contentType == 'application/pdf'"
      }
    ],
    "triggers": [
      {
        "event": "file.added",
        "command": "app:file.createText",
        "when": "target.contentType == 'application/pdf' && !target.versions.exists(v, v.kind == 'page-text' && v.isValid)"
      }
    ]
  },
  "permissions": ["vault:read", "vault:write"],
  "services": ["md.numen.readers.pdf"],
  "backend": {
    "entrypoint": "bin/readers-pdf"
  },
  "frontend": {},
  "settings": [
    {
      "key": "defaultZoom",
      "type": "enum",
      "title": "Default Zoom",
      "description": "Zoom a PDF opens at",
      "options": ["page", "width", "100%"],
      "default": "page"
    }
  ]
}
