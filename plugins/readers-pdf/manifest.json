{
  "id": "md.numen.readers.pdf",
  "name": "PDF Reader",
  "version": "2026.10.6",
  "protocol": 1,
  "description": "PDF document reader with highlights and passage links",
  "capabilities": [],
  "targets": ["desktop.editor"],
  "contributes": {
    "tabKinds": [{ "kind": "reader:reader-pdf", "title": "PDF Reader", "icon": "file-text" }],
    "fileTypes": [{ "tabKind": "reader:reader-pdf", "extensions": ["pdf"] }],
    "feature": "PDF documents",
    "category": "readers",
    "handles": [{ "purpose": "text-provider", "contentTypes": ["application/pdf"] }],
    "readers": [{ "id": "reader-pdf", "contentTypes": ["application/pdf"], "rank": "default" }]
  },
  "activationEvents": [],
  "permissions": ["vault:read", "vault:write"],
  "services": ["numen.pdf"],
  "backend": {
    "type": "process",
    "entrypoint": "bin/readers-pdf",
    "serviceName": "numen.pdf"
  },
  "frontend": {
    "entrypoint": "dist/index.js",
    "styles": "dist/styles.css"
  },
  "settings": [
    {
      "key": "default_zoom",
      "type": "enum",
      "title": "Default Zoom",
      "description": "Initial zoom level when opening a PDF document",
      "options": ["page", "width", "100%"],
      "default": "page"
    }
  ]
}
