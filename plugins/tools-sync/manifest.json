{
  "id": "md.numen.tools.sync",
  "name": "Numen Sync",
  "version": "2026.11.1",
  "protocol": 1,
  "description": "Synchronizes your vaults across devices",
  "targets": ["desktop.editor"],
  "contributes": {
    "category": "tools",
    "licenses": [
      {
        "id": "sync",
        "title": "Numen Sync",
        "description": "Synchronizes your vaults across devices",
        "providers": [
          {
            "provider": "creem",
            "url": "https://www.creem.io/test/payment/prod_5YckdJcFG6a0eH2aETTOAz"
          }
        ]
      }
    ],
    "slots": [{ "slot": "titleBar.status", "view": "sync", "title": "Sync status", "order": 5 }]
  },
  "permissions": ["identity"],
  "backend": {
    "entrypoint": "bin/tools-sync",
    "lifecycle": "persistent"
  },
  "settings": [
    {
      "key": "server",
      "type": "string",
      "title": "Sync server",
      "description": "Address of the server this device signs in to",
      "default": "https://sync.numen.md"
    }
  ],
  "frontend": {}
}
