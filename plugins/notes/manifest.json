{
  "id": "md.numen.notes",
  "name": "Notes",
  "version": "2026.11.12",
  "protocol": 1,
  "description": "Markdown note editor with live formatting and wikilinks",
  "capabilities": [],
  "targets": ["desktop.editor"],
  "contributes": {
    "tabKinds": [
      {
        "kind": "note",
        "title": "Note",
        "icon": "file-text",
        "when": "target.noteType == 'note'",
        "rank": "alternate",
        "isNoteEditor": true
      },
      { "kind": "reader:markdown", "title": "Markdown Note Editor", "icon": "file-text" }
    ],
    "viewCapabilities": ["note-editor"],
    "feature": "Markdown notes",
    "category": "views",
    "readers": [
      { "id": "markdown", "contentTypes": ["text/markdown", "text/plain"], "rank": "default" }
    ],
    "slots": [
      {
        "slot": "titleBar.commands",
        "command": "app:note.create",
        "group": "new",
        "order": 10,
        "when": "window.isVaultOpen"
      }
    ]
  },
  "permissions": ["vault:read", "vault:write"],
  "frontend": {},
  "settings": [
    {
      "key": "softWrap",
      "type": "boolean",
      "title": "Soft Wrap",
      "description": "Wrap long lines to fit the editor viewport",
      "default": true
    },
    {
      "key": "lineNumbers",
      "type": "boolean",
      "title": "Line Numbers",
      "description": "Show line numbers in the editor margin",
      "default": false
    },
    {
      "key": "tabSize",
      "type": "range",
      "title": "Tab Size",
      "description": "Spaces a Tab inserts",
      "default": 2,
      "min": 1,
      "max": 8,
      "step": 1
    },
    {
      "key": "fontFamily",
      "type": "string",
      "title": "Font",
      "description": "Font of the note text; empty uses the interface font",
      "details": "A comma-separated list of families is allowed. A name with spaces needs no quotes.",
      "default": "",
      "options": [
        { "value": "", "title": "Interface font" },
        { "value": "serif", "title": "Serif" },
        { "value": "sans-serif", "title": "Sans-serif" },
        { "value": "monospace", "title": "Monospace" }
      ]
    },
    {
      "key": "lineHeight",
      "type": "range",
      "title": "Line Height",
      "description": "Space between lines, as a multiple of the font size",
      "default": 1.6,
      "min": 1.2,
      "max": 2.4,
      "step": 0.05
    },
    {
      "key": "highlightActiveLine",
      "type": "boolean",
      "title": "Highlight Active Line",
      "description": "Mark the line the caret is on",
      "default": false
    }
  ]
}
