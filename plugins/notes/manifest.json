{
  "id": "md.numen.notes",
  "name": "Notes",
  "version": "2026.11.1",
  "protocol": 1,
  "description": "Markdown note editor with live formatting and wikilinks",
  "capabilities": [],
  "targets": ["desktop.editor"],
  "contributes": {
    "tabKinds": [
      { "kind": "note", "title": "Note", "icon": "file-text" },
      { "kind": "reader:markdown", "title": "Markdown Note Editor", "icon": "file-text" }
    ],
    "feature": "Markdown notes",
    "category": "views",
    "readers": [
      { "id": "markdown", "contentTypes": ["text/markdown", "text/plain"], "rank": "default" }
    ]
  },
  "permissions": ["vault:read", "vault:write"],
  "frontend": {},
  "settings": [
    {
      "key": "soft_wrap",
      "type": "boolean",
      "title": "Soft Wrap",
      "description": "Wrap long lines to fit the editor viewport",
      "default": true
    },
    {
      "key": "line_numbers",
      "type": "boolean",
      "title": "Line Numbers",
      "description": "Show line numbers in the editor margin",
      "default": false
    }
  ]
}
