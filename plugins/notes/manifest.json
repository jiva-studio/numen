{
  "id": "md.numen.notes",
  "name": "Notes",
  "version": "2026.11.12",
  "protocol": 1,
  "description": "Markdown note editor with live formatting and wikilinks",
  "capabilities": [],
  "targets": ["desktop.editor"],
  "contributes": {
    "tabKinds": [
      {
        "kind": "note",
        "title": "Note",
        "icon": "file-text",
        "when": "target.noteType == 'note'",
        "rank": "alternate",
        "isNoteEditor": true
      },
      { "kind": "reader:markdown", "title": "Markdown Note Editor", "icon": "file-text" }
    ],
    "viewCapabilities": ["note-editor"],
    "feature": "Markdown notes",
    "category": "views",
    "readers": [
      { "id": "markdown", "contentTypes": ["text/markdown", "text/plain"], "rank": "default" }
    ],
    "slots": [
      {
        "slot": "titleBar.commands",
        "command": "app:note.create",
        "group": "new",
        "order": 10,
        "when": "window.isVaultOpen"
      }
    ]
  },
  "permissions": ["vault:read", "vault:write"],
  "frontend": {},
  "settings": [
    {
      "key": "softWrap",
      "type": "boolean",
      "title": "Soft Wrap",
      "description": "Wrap long lines to fit the editor viewport",
      "default": true
    },
    {
      "key": "lineNumbers",
      "type": "boolean",
      "title": "Line Numbers",
      "description": "Show line numbers in the editor margin",
      "default": false
    }
  ]
}
