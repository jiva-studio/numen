{
  "id": "md.numen.notes",
  "name": "Notes",
  "version": "2026.10.2",
  "protocol": 1,
  "description": "Markdown note editor with live formatting and wikilinks",
  "capabilities": [],
  "targets": ["desktop.editor"],
  "readers": [
    { "id": "markdown", "contentTypes": ["text/markdown", "text/plain"], "rank": "default" }
  ],
  "activationEvents": [],
  "permissions": ["vault:read", "vault:write"],
  "lifecycle": {
    "idleTimeoutSeconds": 300,
    "keepAliveWhileVisible": true
  },
  "frontend": {
    "entrypoint": "dist/index.js",
    "styles": "dist/styles.css"
  },
  "settings": [
    {
      "key": "soft_wrap",
      "type": "boolean",
      "title": "Soft Wrap",
      "description": "Wrap long lines to fit the editor viewport",
      "default": true
    },
    {
      "key": "line_numbers",
      "type": "boolean",
      "title": "Line Numbers",
      "description": "Show line numbers in the editor margin",
      "default": false
    }
  ]
}
