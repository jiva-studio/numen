{
  "id": "md.numen.engines.transcription",
  "name": "Audio/Video Transcription",
  "version": "2026.11.24",
  "protocol": 1,
  "description": "Offline speech-to-text transcription for audio and video recordings",
  "capabilities": ["tools"],
  "targets": ["desktop.editor"],
  "activationEvents": ["onFilesChanged:audio/*", "onFilesChanged:video/*"],
  "contributes": {
    "textKinds": [{ "kind": "transcript", "title": "Transcript" }],
    "category": "engines",
    "slots": [
      {
        "slot": "fileTree.context",
        "command": "app:file.createText",
        "group": "3-text",
        "order": 10
      }
    ],
    "handlers": [
      {
        "command": "app:file.createText",
        "title": "Transcribe",
        "when": "target.contentType.startsWith('audio/') || target.contentType.startsWith('video/')"
      }
    ]
  },
  "permissions": ["vault:read", "vault:write", "link:open"],
  "dependencies": [
