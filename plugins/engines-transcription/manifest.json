  "lifecycle": {
    "idleTimeoutSeconds": 600,
    "keepAliveWhileVisible": false,
    "memoryLimitBytes": 4294967296
  },
  "backend": {
    "type": "process",
    "entrypoint": "bin/engines-transcription",
    "serviceName": "numen.v1.TextProviderService"
  },
  "settings": [
    {
      "key": "model",
      "type": "enum",
      "title": "Model",
      "description": "Speech recognition model",
      "default": "parakeet-tdt-0.6b-v3-int8",
      "options": [
        {
          "value": "parakeet-tdt-0.6b-v3-int8",
          "title": "Parakeet TDT 0.6B v3",
          "detail": "25 European languages, 670 MB",
          "dependencies": [
            "parakeet-v3-encoder",
            "parakeet-v3-decoder",
            "parakeet-v3-joiner",
            "parakeet-v3-tokens"
          ]
        },
        {
          "value": "parakeet-tdt-0.6b-v2-int8",
          "title": "Parakeet TDT 0.6B v2",
          "detail": "English, 660 MB",
          "dependencies": [
            "parakeet-v2-encoder",
            "parakeet-v2-decoder",
            "parakeet-v2-joiner",
            "parakeet-v2-tokens"
          ]
        }
      ],
      "palette": true
    },
    {
      "key": "language",
      "type": "enum",
      "title": "Language",
      "description": "Language of the recordings",
      "optionsBy": {
        "setting": "model",
        "options": {
          "parakeet-tdt-0.6b-v3-int8": [
            {
              "value": "auto",
              "title": "Detected by the model",
              "detail": "Bulgarian, Croatian, Czech, Danish, Dutch, English, Estonian, Finnish, French, German, Greek, Hungarian, Italian, Latvian, Lithuanian, Maltese, Polish, Portuguese, Romanian, Russian, Slovak, Slovenian, Spanish, Swedish, Ukrainian"
            }
          ],
          "parakeet-tdt-0.6b-v2-int8": [
            {
              "value": "en",
              "title": "English"
            }
          ]
        }
      }
    }
  ]
}
