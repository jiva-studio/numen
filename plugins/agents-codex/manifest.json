{
  "id": "md.numen.agents.codex",
  "name": "OpenAI Codex Agent",
  "version": "1.0.0",
  "protocol": 1,
  "description": "OpenAI Codex CLI agent runner and provider service",
  "capabilities": ["agent", "ai.agent.provider"],
  "targets": ["desktop.editor", "desktop.flashcards"],
  "permissions": ["network:outbound", "vault:read", "vault:write"],
  "lifecycle": {
    "idleTimeoutSeconds": 180,
    "keepAliveWhileVisible": false,
    "memoryLimitBytes": 4294967296
  },
  "backend": {
    "type": "process",
    "entrypoint": "bin/agents-codex",
    "serviceName": "numen.v1.AgentService"
  },
  "settings": [
    {
      "key": "executable_path",
      "type": "file",
      "title": "Executable Path",
      "description": "Path to the OpenAI Codex CLI executable. Empty finds it automatically.",
      "default": ""
    }
  ]
}
