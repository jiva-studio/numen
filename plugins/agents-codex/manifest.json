{
  "id": "md.numen.agents.codex",
  "name": "OpenAI Codex Agent",
  "version": "2026.11.11",
  "protocol": 1,
  "description": "OpenAI Codex assistant for chat and note editing",
  "capabilities": ["ai.agent.provider"],
  "targets": ["desktop.editor", "desktop.flashcards"],
  "contributes": { "category": "agents" },
  "permissions": [
    "link:open",
    "vault:read",
    "vault:write",
    "vault:manage",
    "window:focus",
    "index:read"
  ],
  "backend": { "entrypoint": "bin/agents-codex" },
  "services": ["numen.v1.AgentService"],
  "settings": [
    {
      "key": "executablePath",
      "type": "file",
      "title": "Executable Path",
      "description": "Path to the OpenAI Codex CLI executable. Empty finds it automatically.",
      "default": ""
    }
  ]
}
