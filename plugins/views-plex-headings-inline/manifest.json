{
  "id": "md.numen.views.plex.headings.inline",
  "name": "Plex Headings Inline",
  "version": "2026.11.2",
  "protocol": 1,
  "description": "The headings of a note, written under its node in the plex",
  "capabilities": [],
  "targets": ["desktop.editor"],
  "contributes": {
    "feature": "plex headings inline",
    "category": "views",
    "slots": [
      { "slot": "plexGraph.nodeBelow", "view": "headings", "title": "Headings under a note" }
    ]
  },
  "permissions": ["vault:read"],
  "settings": [
    {
      "key": "headingLimit",
      "type": "range",
      "title": "Headings per note",
      "description": "Most headings shown under a node",
      "default": 6,
      "min": 1,
      "max": 12,
      "step": 1
    }
  ],
  "frontend": {}
}
