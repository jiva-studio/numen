{
  "id": "md.numen.views.flashcards.studio",
  "name": "Flashcards Studio",
  "version": "2026.11.22",
  "protocol": 1,
  "description": "Flashcard deck editor, card template designer, and spaced-repetition review",
  "capabilities": ["tools"],
  "targets": ["desktop.editor", "desktop.flashcards"],
  "contributes": {
    "tabKinds": [
      {
        "kind": "deck",
        "title": "Deck",
        "icon": "layers",
        "when": "target.noteType == 'deck'"
      },
      {
        "kind": "card-model",
        "title": "Card Model",
        "icon": "layout-template",
        "when": "target.noteType == 'card-model'"
      },
      {
        "kind": "preset",
        "title": "Preset",
        "icon": "gauge",
        "when": "target.noteType == 'preset'"
      },
      {
        "kind": "flashcards.review",
        "title": "Flashcards"
      }
    ],
    "viewCapabilities": ["vault-summary"],
    "feature": "flashcards",
    "category": "views",
    "noteTypes": [
      {
        "type": "deck",
        "chunks": false,
        "headings": [1, 2],
        "idHeadingLevels": [2],
        "idPattern": "[0-9a-hjkmnp-tv-z]{10}"
      },
      {
        "type": "card-model",
        "chunks": false,
        "headings": []
      },
      {
        "type": "preset"
      }
    ],
    "commands": [
      {
        "id": "deck.create",
        "title": "Create deck",
        "icon": "layers",
        "arguments": [
          {
            "name": "title",
            "title": "Title",
            "type": "string",
            "required": true
          }
        ]
      },
      {
        "id": "cardModel.create",
        "title": "Create card model",
        "icon": "layout-template",
        "arguments": [
          {
            "name": "title",
            "title": "Title",
            "type": "string",
            "required": true
          }
        ]
      },
      {
        "id": "preset.create",
        "title": "Create preset",
        "icon": "gauge",
        "arguments": [
          {
            "name": "title",
            "title": "Title",
            "type": "string",
            "required": true
          }
        ]
      },
      {
        "id": "preset.open",
        "title": "Open preset",
        "icon": "gauge",
        "when": "target.isNote"
      }
    ],
    "slots": [
      {
        "slot": "fileTree.new",
        "command": "deck.create",
        "group": "1-cards",
        "order": 10,
        "when": "target.isFolder"
      },
      {
        "slot": "fileTree.new",
        "command": "cardModel.create",
        "group": "1-cards",
        "order": 20,
        "when": "target.isFolder"
      },
      {
        "slot": "fileTree.new",
        "command": "preset.create",
        "group": "1-cards",
        "order": 30,
        "when": "target.isFolder"
      },
      {
        "slot": "plexGraph.context",
        "command": "preset.open",
        "group": "1-note",
        "order": 40,
        "when": "target.noteType == 'preset'"
      }
    ]
  },
  "permissions": ["vault:read", "vault:write"],
  "services": ["md.numen.views.flashcards.studio"],
  "settings": [
    {
      "key": "dayStartTime",
      "type": "string",
      "title": "Day starts at",
      "description": "Time a review day starts, HH:MM up to 12:00",
      "details": "The time a review day starts, as HH:MM up to 12:00. Any other value uses 04:00.",
      "default": "04:00"
    },
    {
      "key": "agentConnections",
      "type": "connections",
      "title": "Agents",
      "operations": ["acp.task"],
      "max": 5
    }
  ],
  "backend": {
    "entrypoint": "bin/views-flashcards-studio"
  },
  "frontend": {}
}
