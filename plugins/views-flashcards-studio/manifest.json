{
  "id": "md.numen.views.flashcards.studio",
  "name": "Flashcards Studio",
  "version": "1.0.0",
  "protocol": 1,
  "description": "Flashcard deck editor, card stencil designer, SRS preset studio and the review of the cards",
  "capabilities": ["tools"],
  "targets": ["desktop.editor", "desktop.flashcards"],
  "activationEvents": [],
  "permissions": ["vault:read", "vault:write"],
  "lifecycle": {
    "idleTimeoutSeconds": 300,
    "keepAliveWhileVisible": true,
    "memoryLimitBytes": 1073741824
  },
  "services": ["numen.v1.CardsService", "numen.v1.PresetsService", "numen.v1.FlashcardsService"],
  "noteTypes": [
    {
      "type": "deck",
      "chunks": false,
      "headings": [1, 2],
      "markedHeadings": [2],
      "markPattern": "[0-9a-hjkmnp-tv-z]{10}"
    },
    {
      "type": "stencil",
      "chunks": false,
      "headings": []
    },
    {
      "type": "preset"
    }
  ],
  "commands": [
    {
      "id": "create-deck",
      "title": "New deck",
      "arguments": [
        { "name": "title", "title": "What is it called", "type": "string", "required": true }
      ]
    },
    {
      "id": "create-stencil",
      "title": "New stencil",
      "arguments": [
        { "name": "title", "title": "What is it called", "type": "string", "required": true }
      ]
    },
    {
      "id": "create-preset",
      "title": "New preset",
      "arguments": [
        { "name": "title", "title": "What is it called", "type": "string", "required": true }
      ]
    }
  ],
  "settings": [
    {
      "key": "day_start_time",
      "type": "string",
      "title": "Day starts at",
      "description": "The hour a day of review begins at, as HH:MM from 00:00 to 12:00. An answer given before it is written into the day before. Anything else stands at 04:00.",
      "default": "04:00",
      "replaces": ["review.day_start_time", "review.day_starts"]
    }
  ],
  "backend": {
    "type": "process",
    "entrypoint": "bin/views-flashcards-studio",
    "serviceName": "numen.v1.CardsService"
  },
  "frontend": {
    "entrypoint": "dist/index.js",
    "styles": "dist/styles.css"
  }
}
