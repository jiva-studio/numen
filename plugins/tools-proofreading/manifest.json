{
  "id": "md.numen.tools.proofreading",
  "name": "LLM Proofreading",
  "version": "1.0.0",
  "protocol": 1,
  "description": "Cleans up transcripts and scanned text with a language model",
  "targets": ["desktop.editor"],
  "activationEvents": [],
  "permissions": ["vault:read", "vault:write", "ai:complete", "network:outbound"],
  "secrets": [
    {
      "name": "apiKey",
      "title": "API key",
      "description": "API key for the remote chat service",
      "when": {
        "setting": "provider",
        "is": ["openrouter", "openai", "custom"]
      }
    }
  ],
  "texts": {},
  "commands": [
    {
      "id": "proofread",
      "title": "Proofread",
      "icon": "spell-check",
      "when": { "liveTextKinds": ["*"] }
    },
    {
      "id": "delete-proofreading",
      "title": "Delete proofreading",
      "icon": "trash-2",
      "when": { "hasOwnText": true }
    }
  ],
  "settings": [
    {
      "key": "provider",
      "type": "enum",
      "title": "Provider",
      "description": "How proofreading requests are executed: through a Numen agent or directly against an OpenAI-compatible batch/chat API",
      "default": "agent",
      "options": [
        { "value": "agent", "title": "Agent", "detail": "Uses a configured Numen agent" },
        {
          "value": "openrouter",
          "title": "OpenRouter",
          "detail": "Direct parallel batch requests via OpenRouter API"
        },
        {
          "value": "openai",
          "title": "OpenAI",
          "detail": "Direct parallel batch requests via OpenAI API"
        },
        {
          "value": "custom",
          "title": "Custom service",
          "detail": "Any OpenAI-compatible chat completions API"
        }
      ]
    },
    {
      "key": "agent",
      "type": "agent",
      "title": "Agent",
      "description": "Agent and model used for proofreading",
      "when": {
        "setting": "provider",
        "is": ["agent"]
      }
    },
    {
      "key": "baseUrl",
      "type": "string",
      "title": "Service URL",
      "description": "Base URL of the OpenAI-compatible API, for example http://localhost:11434/v1",
      "default": "",
      "when": {
        "setting": "provider",
        "is": ["custom"]
      }
    },
    {
      "key": "model",
      "type": "string",
      "title": "Model",
      "description": "Model ID used for batch proofreading requests",
      "default": "openai/gpt-4o-mini",
      "when": {
        "setting": "provider",
        "is": ["openrouter", "openai", "custom"]
      },
      "optionsBy": {
        "setting": "provider",
        "options": {
          "openrouter": [
            {
              "value": "google/gemini-2.5-flash",
              "title": "Gemini 2.5 Flash",
              "detail": "Fast, low-cost batch proofreading · OpenRouter"
            },
            {
              "value": "openai/gpt-4o-mini",
              "title": "GPT-4o mini",
              "detail": "Balanced speed and accuracy · OpenRouter"
            },
            {
              "value": "anthropic/claude-3.5-haiku",
              "title": "Claude 3.5 Haiku",
              "detail": "High-accuracy text editing · OpenRouter"
            },
            {
              "value": "deepseek/deepseek-chat",
              "title": "DeepSeek V3",
              "detail": "Cost-effective bulk proofreading · OpenRouter"
            }
          ],
          "openai": [
            {
              "value": "gpt-4o-mini",
              "title": "GPT-4o mini",
              "detail": "Fast, low-cost proofreading · OpenAI"
            },
            {
              "value": "gpt-4.1-mini",
              "title": "GPT-4.1 mini",
              "detail": "High accuracy · OpenAI"
            },
            {
              "value": "gpt-4.1-nano",
              "title": "GPT-4.1 nano",
              "detail": "Lowest cost bulk proofreading · OpenAI"
            }
          ],
          "custom": [
            {
              "value": "gpt-4o-mini",
              "title": "gpt-4o-mini",
              "detail": "OpenAI-compatible model ID"
            }
          ]
        }
      }
    },
    {
      "key": "batch_size",
      "type": "number",
      "title": "Batch size",
      "description": "Lines per model request",
      "default": 40,
      "min": 1,
      "max": 500,
      "step": 1
    },
    {
      "key": "overlap",
      "type": "number",
      "title": "Overlap",
      "description": "Lines shared by neighbouring batches",
      "default": 4,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "key": "in_flight",
      "type": "number",
      "title": "In-flight requests",
      "description": "Parallel model requests per call",
      "default": 4,
      "min": 1,
      "max": 32,
      "step": 1
    },
    {
      "key": "max_edit_distance",
      "type": "number",
      "title": "Max edit distance",
      "description": "Maximum edit distance of a correction from the original line",
      "default": 0.3,
      "min": 0,
      "max": 1,
      "step": 0.05
    }
  ],
  "lifecycle": {
    "idleTimeoutSeconds": 180,
    "keepAliveWhileVisible": false,
    "memoryLimitBytes": 1073741824
  },
  "backend": {
    "type": "process",
    "entrypoint": "bin/tools-proofreading",
    "serviceName": "numen.v1.TextProviderService"
  }
}
