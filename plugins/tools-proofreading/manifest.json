{
  "id": "md.numen.tools.proofreading",
  "name": "LLM Proofreading",
  "version": "1.0.0",
  "protocol": 1,
  "description": "Proofreads transcripts and recognised text with a language model, as a new text version",
  "targets": ["desktop.editor"],
  "activationEvents": [],
  "permissions": ["vault:read", "vault:write", "ai:complete"],
  "textInput": {
    "kinds": ["transcript", "recognition", "page-text"]
  },
  "commands": [
    {
      "id": "proofread",
      "title": "Proofread text",
      "contentTypes": ["*/*"],
      "hiddenInPalette": true
    }
  ],
  "settings": [
    {
      "key": "agent",
      "type": "agent",
      "title": "Agent",
      "description": "Agent and model used for proofreading"
    },
    {
      "key": "batch_size",
      "type": "number",
      "title": "Batch size",
      "description": "Lines per model request",
      "default": 40
    },
    {
      "key": "overlap",
      "type": "number",
      "title": "Overlap",
      "description": "Lines shared by neighbouring batches",
      "default": 4
    },
    {
      "key": "in_flight",
      "type": "number",
      "title": "In-flight requests",
      "description": "Parallel model requests per call",
      "default": 4
    },
    {
      "key": "max_edit_distance",
      "type": "number",
      "title": "Max edit distance",
      "description": "Maximum edit distance of a correction from the original line",
      "default": 0.3
    }
  ],
  "lifecycle": {
    "idleTimeoutSeconds": 180,
    "keepAliveWhileVisible": false,
    "memoryLimitBytes": 1073741824
  },
  "backend": {
    "type": "process",
    "entrypoint": "bin/tools-proofreading",
    "serviceName": "numen.v1.TextProviderService"
  }
}
