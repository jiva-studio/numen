{
  "id": "md.numen.tools.proofreading",
  "name": "LLM Proofreading",
  "version": "2026.11.12",
  "protocol": 1,
  "description": "Cleans up transcripts and scanned text with a language model",
  "targets": ["desktop.editor"],
  "contributes": {
    "textKinds": [{ "kind": "proofreading", "title": "Proofread text" }],
    "category": "tools",
    "commands": [
      {
        "id": "proofreading.create",
        "title": "Proofread text",
        "icon": "spell-check",
        "when": "version.isLive && version.kind != ''"
      }
    ],
    "handlers": [
      {
        "command": "app:file.createText",
        "title": "Proofread text",
        "when": "target.versions.exists(v, v.isLive && (v.kind == 'transcript' || v.kind == 'recognition'))"
      }
    ],
    "triggers": [
      {
        "event": "file.added",
        "command": "app:file.createText",
        "when": "config.md.numen.tools.proofreading.proofreadAutomatically == true && !target.versions.exists(v, v.pluginId == 'md.numen.tools.proofreading' && v.isValid)"
      }
    ]
  },
  "permissions": ["vault:read", "vault:write"],
  "settings": [
    {
      "key": "proofreadAutomatically",
      "type": "boolean",
      "title": "Proofread automatically",
      "description": "Proofread every transcript and recognized text that has none",
      "default": false
    },
    {
      "key": "connections",
      "type": "connections",
      "title": "Connections",
      "description": "Services and agents, tried in order until one answers",
      "operations": ["llm.complete"],
      "max": 5
    },
    {
      "key": "batchSize",
      "type": "number",
      "title": "Batch size",
      "description": "Lines per model request",
      "default": 40,
      "min": 1,
      "max": 500,
      "step": 1
    },
    {
      "key": "overlap",
      "type": "number",
      "title": "Overlap",
      "description": "Lines shared by neighboring batches",
      "default": 4,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "key": "inFlight",
      "type": "number",
      "title": "In-flight requests",
      "description": "Parallel model requests per call",
      "default": 4,
      "min": 1,
      "max": 32,
      "step": 1
    },
    {
      "key": "maxEditDistance",
      "type": "number",
      "title": "Max edit distance",
      "description": "Largest edit distance of a correction from its line",
      "default": 0.3,
      "min": 0,
      "max": 1,
      "step": 0.05
    }
  ],
  "backend": {
    "entrypoint": "bin/tools-proofreading"
  }
}
