{
  "id": "md.numen.tools.proofreading",
  "name": "LLM Proofreading",
  "version": "2026.11.12",
  "protocol": 1,
  "description": "Cleans up transcripts and scanned text with a language model",
  "targets": ["desktop.editor"],
  "contributes": {
    "textKinds": [{ "kind": "proofreading", "title": "Proofread text" }],
    "category": "tools",
    "commands": [
      {
        "id": "proofreading.create",
        "title": "Proofread text",
        "icon": "spell-check",
        "when": "version.isLive && version.kind != ''"
      }
    ]
  },
  "permissions": ["vault:read", "vault:write"],
  "settings": [
    {
      "key": "connections",
      "type": "connections",
      "title": "Connections",
      "description": "Services and agents, tried in order until one answers",
      "operations": ["llm.complete"],
      "max": 5
    },
    {
      "key": "language",
      "type": "string",
      "title": "Language of the text",
      "description": "Language of the text; empty detects it from the text",
      "details": "What language the text is in. When empty, the model reads the language from the text.",
      "default": "",
      "options": [
        { "value": "English", "title": "English" },
        { "value": "Russian", "title": "Russian" },
        { "value": "German", "title": "German" },
        { "value": "French", "title": "French" },
        { "value": "Spanish", "title": "Spanish" },
        { "value": "Italian", "title": "Italian" },
        { "value": "Portuguese", "title": "Portuguese" },
        { "value": "Hindi", "title": "Hindi" },
        { "value": "Sanskrit", "title": "Sanskrit" },
        { "value": "Bengali", "title": "Bengali" },
        { "value": "Chinese", "title": "Chinese" },
        { "value": "Japanese", "title": "Japanese" }
      ]
    },
    {
      "key": "prompt",
      "type": "string",
      "title": "Own prompt",
      "description": "Own rules for the model, added to the built-in instruction",
      "details": "Rules of your own for the model, added to the built-in instruction. The answer format cannot be changed.",
      "default": ""
    },
    {
      "key": "batchSize",
      "type": "number",
      "title": "Batch size",
      "description": "Lines per model request",
      "default": 40,
      "min": 1,
      "max": 500,
      "step": 1
    },
    {
      "key": "overlap",
      "type": "number",
      "title": "Overlap",
      "description": "Lines shared by neighboring batches",
      "default": 4,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "key": "inFlight",
      "type": "number",
      "title": "In-flight requests",
      "description": "Parallel model requests per call",
      "default": 4,
      "min": 1,
      "max": 32,
      "step": 1
    },
    {
      "key": "maxEditDistance",
      "type": "number",
      "title": "Max edit distance",
      "description": "Largest edit distance of a correction from its line",
      "default": 0.3,
      "min": 0,
      "max": 1,
      "step": 0.05
    }
  ],
  "backend": {
    "entrypoint": "bin/tools-proofreading"
  }
}
