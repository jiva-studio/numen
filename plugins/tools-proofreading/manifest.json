{
  "id": "md.numen.tools.proofreading",
  "name": "LLM Proofreading",
  "version": "2026.11.11",
  "protocol": 1,
  "description": "Cleans up transcripts and scanned text with a language model",
  "targets": ["desktop.editor"],
  "contributes": {
    "textKinds": [{ "kind": "proofreading", "title": "Proofread text" }],
    "category": "tools",
    "commands": [
      {
        "id": "proofreading.create",
        "title": "Proofread text",
        "icon": "spell-check",
        "when": "version.isLive && version.kind != ''"
      }
    ]
  },
  "permissions": ["vault:read", "vault:write"],
  "settings": [
    {
      "key": "connections",
      "type": "connections",
      "title": "Connections",
      "description": "Services and agents that proofread, tried in order. The next one is used when one cannot answer.",
      "operations": ["llm.complete"],
      "max": 5
    },
    {
      "key": "batchSize",
      "type": "number",
      "title": "Batch size",
      "description": "Lines per model request",
      "default": 40,
      "min": 1,
      "max": 500,
      "step": 1
    },
    {
      "key": "overlap",
      "type": "number",
      "title": "Overlap",
      "description": "Lines shared by neighbouring batches",
      "default": 4,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "key": "inFlight",
      "type": "number",
      "title": "In-flight requests",
      "description": "Parallel model requests per call",
      "default": 4,
      "min": 1,
      "max": 32,
      "step": 1
    },
    {
      "key": "maxEditDistance",
      "type": "number",
      "title": "Max edit distance",
      "description": "Maximum edit distance of a correction from the original line",
      "default": 0.3,
      "min": 0,
      "max": 1,
      "step": 0.05
    }
  ],
  "backend": {
    "entrypoint": "bin/tools-proofreading"
  }
}
