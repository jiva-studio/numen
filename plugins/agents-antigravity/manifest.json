{
  "id": "md.numen.agents.antigravity",
  "name": "Antigravity Agent",
  "version": "2026.10.2",
  "protocol": 1,
  "description": "Google Antigravity AI assistant for chat and note editing",
  "capabilities": ["agent", "ai.agent.provider"],
  "targets": ["desktop.editor", "desktop.flashcards"],
  "contributes": { "category": "agents" },
  "permissions": ["network:outbound", "vault:read", "vault:write"],
  "lifecycle": {
    "idleTimeoutSeconds": 180,
    "keepAliveWhileVisible": false,
    "memoryLimitBytes": 4294967296
  },
  "backend": {
    "type": "process",
    "entrypoint": "bin/agents-antigravity",
    "serviceName": "numen.v1.AgentService"
  },
  "settings": [
    {
      "key": "executable_path",
      "type": "file",
      "title": "Executable Path",
      "description": "Path to the Antigravity CLI executable. Empty finds it automatically.",
      "default": ""
    }
  ]
}
