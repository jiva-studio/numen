{
  "id": "md.numen.tools.media.importer",
  "name": "Media Importer",
  "version": "2026.11.26",
  "protocol": 1,
  "description": "Saves web articles and downloads online videos for offline playback",
  "capabilities": ["tools"],
  "targets": ["desktop.editor"],
  "activationEvents": ["onFilesChanged:note:link"],
  "contributes": {
    "textKinds": [
      {
        "kind": "article",
        "title": "Article"
      },
      {
        "kind": "captions",
        "title": "Captions"
      }
    ],
    "dropHandlers": [
      {
        "types": ["text/uri-list"]
      }
    ],
    "feature": "media links",
    "category": "tools",
    "noteTypes": [
      {
        "type": "link"
      }
    ],
    "frameOrigins": ["https://www.youtube-nocookie.com"],
    "slots": [
      {
        "slot": "fileTree.context",
        "command": "app:file.createText",
        "group": "3-text",
        "order": 10
      },
      {
        "slot": "fileTree.context",
        "command": "link.downloadMedia",
        "group": "3-text",
        "order": 30
      },
      {
        "slot": "fileTree.context",
        "command": "link.deleteMedia",
        "group": "3-text",
        "order": 40
      }
    ],
    "commands": [
      {
        "id": "link.import",
        "title": "Import link",
        "icon": "link",
        "arguments": [
          {
            "name": "address",
            "title": "Web address",
            "type": "string",
            "required": true
          }
        ]
      },
      {
        "id": "link.downloadMedia",
        "title": "Download media",
        "icon": "download",
        "when": "target.noteType == 'link'"
      },
      {
        "id": "link.deleteMedia",
        "title": "Delete media",
        "icon": "trash-2",
        "when": "target.noteType == 'link' && has(target.properties.media) && target.properties.media != ''"
      }
    ],
    "handlers": [
      {
        "command": "app:file.createText",
        "title": "Download captions",
        "when": "target.noteType == 'link'"
      }
    ]
  },
  "permissions": ["vault:read", "vault:write", "link:open"],
  "services": ["md.numen.tools.media.importer"],
  "backend": {
    "entrypoint": "bin/tools-media-importer"
  },
  "frontend": {},
  "settingGroups": [
    { "id": "tools", "title": "Tools" },
    { "id": "captions", "title": "Captions" }
  ],
  "settings": [
    {
      "key": "ytDlp",
      "group": "tools",
      "type": "string",
      "title": "yt-dlp",
      "description": "Path to the yt-dlp program",
      "default": ""
    },
    {
      "key": "ffmpeg",
      "group": "tools",
      "type": "string",
      "title": "ffmpeg",
      "description": "Path to the ffmpeg program",
      "default": ""
    },
    {
      "key": "captions",
      "group": "captions",
      "type": "string",
      "title": "Caption languages",
      "description": "Preferred caption languages, comma-separated",
      "default": ""
    },
    {
      "key": "automaticCaptions",
      "group": "captions",
      "type": "boolean",
      "title": "Automatic captions",
      "description": "Use auto-generated captions when a site has no others",
      "default": true
    },
    {
      "key": "downloadCaptionsAutomatically",
      "group": "captions",
      "type": "boolean",
      "title": "Download captions automatically",
      "description": "Download captions or the article of link notes without them",
      "default": false
    },
    {
      "key": "copyMaxSizeMb",
      "type": "number",
      "title": "Maximum download size",
      "description": "Largest video to download, in MB; 0 for no limit",
      "default": 500,
      "min": 0,
      "max": 100000,
      "step": 50
    }
  ],
  "dependencies": [
    {
      "id": "yt-dlp",
      "kind": "binary",
      "version": "2026.10.26",
      "metadata": {
        "binary": "yt-dlp",
        "fileName": "yt-dlp",
        "envVar": "NUMEN_YT_DLP"
      },
      "sources": [
        {
          "platform": "linux/amd64",
          "sourceUrl": "https://github.com/yt-dlp/yt-dlp/releases/download/2026.10.26/yt-dlp_linux",
          "checksumSha256": "767ba9dce7052aa196f8b12652f433d76de128ba168966fa84b6394d5e6c6795"
        },
        {
          "platform": "linux/arm64",
          "sourceUrl": "https://github.com/yt-dlp/yt-dlp/releases/download/2026.10.26/yt-dlp_linux_aarch64",
          "checksumSha256": "e87e9533e89fe5889abaa21f5114dfe7756d6aa6219b83551add04d48b18e483"
        },
        {
          "platform": "darwin/amd64",
