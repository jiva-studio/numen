{
  "id": "md.numen.tools.media.importer",
  "name": "Media Importer",
  "version": "1.0.0",
  "protocol": 1,
  "description": "Keeps web links as notes, fetches their articles and captions, and downloads videos for offline playback",
  "targets": [
    "desktop.editor"
  ],
  "activationEvents": [],
  "permissions": [
    "vault:read",
    "vault:write",
    "network:outbound"
  ],
  "noteTypes": [
    {
      "type": "link"
    }
  ],
  "services": [
    "numen.links.v1.LinkService"
  ],
  "textInput": {
    "noteTypes": [
      "link"
    ]
  },
  "playback": {
    "noteTypes": [
      "link"
    ]
  },
  "commands": [
    {
      "id": "import",
      "title": "Import from URL",
      "arguments": [
        {
          "name": "address",
          "title": "The address",
          "type": "string",
          "required": true
        },
        {
          "name": "wait",
          "title": "Wait for the copy of the video",
          "type": "boolean"
        }
      ]
    },
    {
      "id": "download-text",
      "title": "Download text again",
      "noteTypes": [
        "link"
      ]
    },
    {
      "id": "download-copy",
      "title": "Download video",
      "noteTypes": [
        "link"
      ]
    },
    {
      "id": "delete-copy",
      "title": "Delete downloaded video",
      "noteTypes": [
        "link"
      ]
    }
  ],
  "lifecycle": {
    "idleTimeoutSeconds": 180,
    "keepAliveWhileVisible": false,
    "memoryLimitBytes": 2147483648
  },
  "backend": {
    "type": "process",
    "entrypoint": "bin/tools-media-importer",
    "serviceName": "numen.links.v1.LinkService"
  },
  "frontend": {
    "entrypoint": "dist/index.js",
    "styles": "dist/styles.css"
  },
  "settings": [
    {
      "key": "yt_dlp",
      "type": "string",
      "title": "yt-dlp",
      "description": "Path to the yt-dlp program",
      "default": "",
      "replaces": [
        "importing.yt_dlp"
      ]
    },
    {
      "key": "ffmpeg",
      "type": "string",
      "title": "ffmpeg",
      "description": "Path to the ffmpeg program",
      "default": "",
      "replaces": [
        "importing.ffmpeg"
      ]
    },
    {
      "key": "captions",
      "type": "string",
      "title": "Caption languages",
      "description": "Caption languages in order of preference, comma-separated",
      "default": ""
    },
    {
      "key": "automatic_captions",
      "type": "boolean",
      "title": "Automatic captions",
      "description": "Use auto-generated captions when a site has no others",
      "default": true
    },
    {
      "key": "copy_max_size_mb",
      "type": "number",
      "title": "Maximum download size",
      "description": "Maximum video download size in megabytes; 0 for no limit",
      "default": 500,
      "min": 0,
      "max": 100000,
      "step": 50
    }
  ]
}
