{
  "id": "md.numen.tools.media.importer",
  "name": "Media Importer",
  "version": "2026.11.15",
  "protocol": 1,
  "description": "Saves web articles and downloads online videos for offline playback",
  "capabilities": ["tools"],
  "targets": ["desktop.editor"],
  "contributes": {
    "textKinds": [
      { "kind": "article", "title": "Article" },
      { "kind": "captions", "title": "Captions" }
    ],
    "dropHandlers": [{ "types": ["text/uri-list"] }],
    "feature": "media links",
    "category": "tools",
    "noteTypes": [
      {
        "type": "link"
      }
    ],
    "frameOrigins": ["https://www.youtube-nocookie.com"],
    "slots": [
      {
        "slot": "fileTree.context",
        "command": "app:file.createText",
        "group": "3-text",
        "order": 10
      },
      {
        "slot": "fileTree.context",
        "command": "app:link.downloadMedia",
        "group": "3-text",
        "order": 30
      },
      {
        "slot": "fileTree.context",
        "command": "app:link.deleteMedia",
        "group": "3-text",
        "order": 40
      }
    ],
    "handlers": [
      {
        "command": "app:link.import",
        "title": "Import link"
      },
      {
        "command": "app:file.createText",
        "title": "Download captions",
        "when": "target.noteType == 'link'"
      },
      {
        "command": "app:link.downloadMedia",
        "title": "Download media",
        "when": "target.noteType == 'link'"
      },
      {
        "command": "app:link.deleteMedia",
        "title": "Delete media",
        "when": "target.noteType == 'link' && has(target.properties.media) && target.properties.media != ''"
      }
    ],
    "triggers": [
      {
        "event": "file.added",
        "command": "app:file.createText",
        "when": "target.noteType == 'link' && config.md.numen.tools.media.importer.downloadCaptionsAutomatically == true && !target.versions.exists(v, v.pluginId == 'md.numen.tools.media.importer' && v.isValid)"
      }
    ]
  },
  "permissions": ["vault:read", "vault:write", "network:outbound"],
  "services": ["md.numen.tools.media.importer"],
  "backend": {
    "entrypoint": "bin/tools-media-importer"
  },
  "frontend": {},
  "settings": [
    {
      "key": "ytDlp",
      "type": "string",
      "title": "yt-dlp",
      "description": "Path to the yt-dlp program",
      "default": ""
    },
    {
      "key": "ffmpeg",
      "type": "string",
      "title": "ffmpeg",
      "description": "Path to the ffmpeg program",
      "default": ""
    },
    {
      "key": "captions",
      "type": "string",
      "title": "Caption languages",
      "description": "Caption languages in order of preference, comma-separated",
      "default": ""
    },
    {
      "key": "automaticCaptions",
      "type": "boolean",
      "title": "Automatic captions",
      "description": "Use auto-generated captions when a site has no others",
      "default": true
    },
    {
      "key": "downloadCaptionsAutomatically",
      "type": "boolean",
      "title": "Download captions automatically",
      "description": "Download the captions or the article of every link note that has none. A text removed with Delete text is downloaded again",
      "default": false
    },
    {
      "key": "copyMaxSizeMb",
      "type": "number",
      "title": "Maximum download size",
      "description": "Maximum video download size in megabytes; 0 for no limit",
      "default": 500,
      "min": 0,
      "max": 100000,
      "step": 50
    }
  ]
}
