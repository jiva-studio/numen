{
  "id": "md.numen.tools.media.importer",
  "name": "Media Importer",
  "version": "1.0.0",
  "protocol": 1,
  "description": "Saves web articles and downloads online videos for offline playback",
  "targets": ["desktop.editor"],
  "activationEvents": [],
  "permissions": ["vault:read", "vault:write", "network:outbound"],
  "noteTypes": [
    {
      "type": "link"
    }
  ],
  "services": ["numen.importer"],
  "texts": {},
  "playback": {
    "noteTypes": ["link"]
  },
  "commands": [
    {
      "id": "import",
      "title": "Import from URL",
      "icon": "link",
      "arguments": [
        {
          "name": "address",
          "title": "The address",
          "type": "string",
          "required": true
        },
        {
          "name": "wait",
          "title": "Wait for the copy of the video",
          "type": "boolean",
          "hiddenInPalette": true
        }
      ]
    },
    {
      "id": "download-text",
      "title": "Download text again",
      "icon": "refresh-cw",
      "noteTypes": ["link"]
    },
    {
      "id": "download-copy",
      "title": "Download video",
      "icon": "download",
      "noteTypes": ["link"]
    },
    {
      "id": "delete-text",
      "title": "Delete text",
      "icon": "trash-2",
      "when": { "hasOwnText": true }
    },
    {
      "id": "delete-copy",
      "title": "Delete downloaded video",
      "icon": "trash-2",
      "noteTypes": ["link"]
    }
  ],
  "lifecycle": {
    "idleTimeoutSeconds": 180,
    "keepAliveWhileVisible": false,
    "memoryLimitBytes": 2147483648
  },
  "backend": {
    "type": "process",
    "entrypoint": "bin/tools-media-importer",
    "serviceName": "numen.importer"
  },
  "frontend": {
    "entrypoint": "dist/index.js",
    "styles": "dist/styles.css"
  },
  "settings": [
    {
      "key": "yt_dlp",
      "type": "string",
      "title": "yt-dlp",
      "description": "Path to the yt-dlp program",
      "default": "",
      "replaces": ["importing.yt_dlp"]
    },
    {
      "key": "ffmpeg",
      "type": "string",
      "title": "ffmpeg",
      "description": "Path to the ffmpeg program",
      "default": "",
      "replaces": ["importing.ffmpeg"]
    },
    {
      "key": "captions",
      "type": "string",
      "title": "Caption languages",
      "description": "Caption languages in order of preference, comma-separated",
      "default": ""
    },
    {
      "key": "automatic_captions",
      "type": "boolean",
      "title": "Automatic captions",
      "description": "Use auto-generated captions when a site has no others",
      "default": true
    },
    {
      "key": "copy_max_size_mb",
      "type": "number",
      "title": "Maximum download size",
      "description": "Maximum video download size in megabytes; 0 for no limit",
      "default": 500,
      "min": 0,
      "max": 100000,
      "step": 50
    }
  ],
  "frames": ["https://www.youtube-nocookie.com"]
}
