{
  "id": "md.numen.tools.media.importer",
  "name": "Media Importer",
  "version": "2026.11.5",
  "protocol": 1,
  "description": "Saves web articles and downloads online videos for offline playback",
  "targets": ["desktop.editor"],
  "contributes": {
    "tabKinds": [{ "kind": "link", "title": "Link", "icon": "link" }],
    "feature": "media links",
    "category": "tools",
    "handles": [
      { "purpose": "text-provider" },
      { "purpose": "playback-copy", "noteTypes": ["link"] }
    ],
    "noteTypes": [{ "type": "link" }],
    "frameOrigins": ["https://www.youtube-nocookie.com"]
  },
  "permissions": ["vault:read", "vault:write", "network:outbound"],
  "services": ["md.numen.tools.media.importer"],
  "commands": [
    {
      "id": "link.import",
      "title": "Import from URL",
      "icon": "link",
      "arguments": [
        {
          "name": "address",
          "title": "The address",
          "type": "string",
          "required": true
        },
        {
          "name": "wait",
          "title": "Wait for the copy of the video",
          "type": "boolean",
          "hiddenInPalette": true
        }
      ]
    },
    {
      "id": "link.downloadText",
      "title": "Download text again",
      "icon": "refresh-cw",
      "noteTypes": ["link"]
    },
    {
      "id": "link.downloadVideo",
      "title": "Download video",
      "icon": "download",
      "noteTypes": ["link"]
    },
    {
      "id": "link.deleteText",
      "title": "Delete text",
      "icon": "trash-2",
      "when": [{ "key": "version.plugin", "is": ["md.numen.tools.media.importer"] }]
    },
    {
      "id": "link.deleteVideo",
      "title": "Delete downloaded video",
      "icon": "trash-2",
      "noteTypes": ["link"]
    }
  ],
  "backend": { "entrypoint": "bin/tools-media-importer" },
  "frontend": {},
  "settings": [
    {
      "key": "yt_dlp",
      "type": "string",
      "title": "yt-dlp",
      "description": "Path to the yt-dlp program",
      "default": "",
      "replaces": ["importing.yt_dlp"]
    },
    {
      "key": "ffmpeg",
      "type": "string",
      "title": "ffmpeg",
      "description": "Path to the ffmpeg program",
      "default": "",
      "replaces": ["importing.ffmpeg"]
    },
    {
      "key": "captions",
      "type": "string",
      "title": "Caption languages",
      "description": "Caption languages in order of preference, comma-separated",
      "default": ""
    },
    {
      "key": "automatic_captions",
      "type": "boolean",
      "title": "Automatic captions",
      "description": "Use auto-generated captions when a site has no others",
      "default": true
    },
    {
      "key": "copy_max_size_mb",
      "type": "number",
      "title": "Maximum download size",
      "description": "Maximum video download size in megabytes; 0 for no limit",
      "default": 500,
      "min": 0,
      "max": 100000,
      "step": 50
    }
  ]
}
