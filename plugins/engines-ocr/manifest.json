{
  "id": "md.numen.engines.ocr",
  "name": "Document OCR",
  "version": "2026.11.23",
  "protocol": 1,
  "description": "Text recognition for scanned PDFs and images",
  "capabilities": ["tools"],
  "targets": ["desktop.editor"],
  "activationEvents": [
    "onFilesChanged:application/pdf",
    "onFilesChanged:image/png",
    "onFilesChanged:image/jpeg",
    "onFilesChanged:image/gif",
    "onFilesChanged:image/webp"
  ],
  "contributes": {
    "textKinds": [{ "kind": "recognition", "title": "Recognized text" }],
    "category": "engines",
    "slots": [
      {
        "slot": "fileTree.context",
        "command": "app:file.createText",
        "group": "3-text",
        "order": 10
      }
    ],
    "handlers": [
      {
        "command": "app:file.createText",
        "title": "Recognize text",
        "when": "target.contentType in ['application/pdf', 'image/png', 'image/jpeg', 'image/gif', 'image/webp']"
      }
    ]
  },
  "permissions": ["vault:read", "vault:write", "link:open"],
  "dependencies": [
