{
  "id": "md.numen.engines.ocr",
  "name": "Document OCR",
  "version": "2026.11.24",
  "protocol": 1,
  "description": "Text recognition for scanned PDFs and images",
  "capabilities": ["tools"],
  "targets": ["desktop.editor"],
  "activationEvents": [
    "onFilesChanged:application/pdf",
    "onFilesChanged:image/png",
    "onFilesChanged:image/jpeg",
    "onFilesChanged:image/gif",
    "onFilesChanged:image/webp"
  ],
  "contributes": {
    "textKinds": [{ "kind": "recognition", "title": "Recognized text" }],
    "category": "engines",
    "slots": [
      {
        "slot": "fileTree.context",
        "command": "app:file.createText",
        "group": "3-text",
        "order": 10
      }
    ],
    "handlers": [
      {
        "command": "app:file.createText",
        "title": "Recognize text",
        "when": "target.contentType in ['application/pdf', 'image/png', 'image/jpeg', 'image/gif', 'image/webp']"
      }
    ]
  },
  "permissions": ["vault:read", "vault:write", "link:open"],
  "dependencies": [
    {
      "id": "onnxruntime",
      "kind": "runtime",
      "version": "1.23.0",
      "sources": [
        {
          "platform": "linux/amd64",
          "sourceUrls": [
            "https://github.com/microsoft/onnxruntime/releases/download/v1.23.0/onnxruntime-linux-x64-1.23.0.tgz",
            "https://dl.photoprism.app/onnx/runtime/v1.23.0/onnxruntime-linux-x64-1.23.0.tgz"
          ],
          "checksumSha256": "b6deea7f2e22c10c043019f294a0ea4d2a6c0ae52a009c34847640db75ec5580",
          "archiveMember": "libonnxruntime.so*",
          "memberSha256": "98b0253652d36c706cd9b873f3e8dc74e107c26cf9694672fb4d88da1c00f250"
        },
        {
          "platform": "linux/arm64",
          "sourceUrls": [
            "https://github.com/microsoft/onnxruntime/releases/download/v1.23.0/onnxruntime-linux-aarch64-1.23.0.tgz",
            "https://dl.photoprism.app/onnx/runtime/v1.23.0/onnxruntime-linux-aarch64-1.23.0.tgz"
          ],
          "checksumSha256": "0b9f47d140411d938e47915824d8daaa424df95a88b5f1fc843172a75168f7a0",
          "archiveMember": "libonnxruntime.so*",
          "memberSha256": "cb068adc50115db2cca077b385a15b35cc07a14ef3bb71aa5d7c66f1982f5264"
        },
        {
          "platform": "darwin/arm64",
          "sourceUrls": [
            "https://github.com/microsoft/onnxruntime/releases/download/v1.23.0/onnxruntime-osx-arm64-1.23.0.tgz",
            "https://dl.photoprism.app/onnx/runtime/v1.23.0/onnxruntime-osx-arm64-1.23.0.tgz"
          ],
          "checksumSha256": "8182db0ebb5caa21036a3c78178f17fabb98a7916bdab454467c8f4cf34bcfdf",
          "archiveMember": "libonnxruntime.1.23.0.dylib",
          "memberSha256": "d3859aecdb70ea099f5b5f4185fe16f0527c6680b18731e6e96fc971ec767cca"
        },
        {
          "platform": "darwin/amd64",
          "sourceUrls": [
            "https://github.com/microsoft/onnxruntime/releases/download/v1.23.0/onnxruntime-osx-x86_64-1.23.0.tgz",
            "https://dl.photoprism.app/onnx/runtime/v1.23.0/onnxruntime-osx-x86_64-1.23.0.tgz"
          ],
          "checksumSha256": "a8e43edcaa349cbfc51578a7fc61ea2b88793ccf077b4bc65aca58999d20cf0f",
          "archiveMember": "libonnxruntime.*dylib",
          "memberSha256": "091d265e49da84ac8eafd6ff76b67688555192a272d784a252d550a858797d6f"
        },
        {
          "platform": "windows/amd64",
          "sourceUrls": [
            "https://github.com/microsoft/onnxruntime/releases/download/v1.23.0/onnxruntime-win-x64-1.23.0.zip",
            "https://dl.photoprism.app/onnx/runtime/v1.23.0/onnxruntime-win-x64-1.23.0.zip"
          ],
          "checksumSha256": "72c23470310ec79a7d42d27fe9d257e6c98540c73fa5a1db1f67f538c6c16f2f",
          "archiveMember": "onnxruntime.dll",
          "memberSha256": "b4b7f9aed3cf6b04000f595bddcbdf12e87214bc401d1b81beadae3dbf28d2bd"
        }
      ],
      "search": [
        "$NUMEN_ONNX_RUNTIME_LIB",
        "$HOME/.nix-profile/lib/libonnxruntime.so*",
        "$HOME/.nix-profile/lib/libonnxruntime.*dylib",
        "/run/current-system/sw/lib/libonnxruntime.so*",
        "/run/current-system/sw/lib/libonnxruntime.*dylib",
        "/nix/store/*-onnxruntime-1.2[3-9]*/lib/libonnxruntime.so*",
        "/nix/store/*-onnxruntime-1.2[3-9]*/lib/libonnxruntime.*dylib"
      ],
      "environment": [
        "NUMEN_ONNX_PROVIDER",
        "LD_LIBRARY_PATH",
        "DYLD_LIBRARY_PATH",
        "DYLD_FALLBACK_LIBRARY_PATH",
        "CUDA_VISIBLE_DEVICES",
        "CUDA_PATH",
        "CUDA_PATH_V*",
        "CUDA_HOME",
        "NVIDIA_VISIBLE_DEVICES",
        "NVIDIA_DRIVER_CAPABILITIES",
        "ROCR_VISIBLE_DEVICES",
        "HIP_VISIBLE_DEVICES"
      ],
      "metadata": {
        "envVar": "NUMEN_ONNX_RUNTIME_LIB"
      }
    }
  ],
  "backend": {
    "entrypoint": "bin/engines-ocr",
    "idleStopSeconds": 600
  },
  "settings": [
    {
      "key": "model",
      "type": "enum",
      "title": "Model",
      "description": "Text recognition model",
      "default": "pp-ocrv6-tiny",
      "options": [
        {
          "value": "pp-ocrv6-tiny",
          "title": "PP-OCRv6 tiny",
          "detail": "Chinese, English and Latin-script languages, 4.5 MB"
        },
        {
          "value": "pp-ocrv6-small",
          "title": "PP-OCRv6 small",
          "detail": "Chinese, English, Japanese and Latin-script languages, 21 MB"
        },
        {
          "value": "pp-ocrv5-latin",
          "title": "PP-OCRv5 Latin",
          "detail": "English, French, German, Spanish, Italian, Portuguese, Dutch, Polish, Czech, Slovak, Hungarian, Romanian, Croatian, Slovenian, Danish, Swedish, Norwegian, Finnish, Estonian, Lithuanian, Latvian, Turkish, Latin and other Latin-script languages, 7.9 MB"
        },
        {
          "value": "pp-ocrv5-eslav",
          "title": "PP-OCRv5 East Slavic",
          "detail": "Russian, Ukrainian, Belarusian, English, 7.9 MB"
        },
        {
          "value": "pp-ocrv5-cyrillic",
          "title": "PP-OCRv5 Cyrillic",
          "detail": "Russian, Ukrainian, Belarusian, Bulgarian, Serbian, Macedonian, Mongolian, Kazakh, Kyrgyz, Tajik, Tatar and other Cyrillic-script languages, English, 8.1 MB"
        },
        {
          "value": "pp-ocrv5-devanagari",
          "title": "PP-OCRv5 Devanagari",
          "detail": "Hindi, Sanskrit, Marathi, Nepali, Konkani, Maithili, Bhojpuri, English, 7.9 MB"
        },
        {
          "value": "pp-ocrv5-greek",
          "title": "PP-OCRv5 Greek",
          "detail": "Greek, English, 7.8 MB"
        },
        {
          "value": "custom",
          "title": "Custom model",
          "detail": "Languages unknown: they are those of the model file"
        }
      ]
    },
    {
      "key": "customModelPath",
      "type": "file",
      "title": "Model file",
      "description": "PaddleOCR text recognition model in ONNX format",
      "accept": [".onnx"],
      "default": "",
      "when": {
        "setting": "model",
        "is": ["custom"]
      }
    },
    {
      "key": "customDictPath",
      "type": "file",
      "title": "Character dictionary",
      "description": "UTF-8 text, one character per line",
      "details": "A UTF-8 text file with one character per line. Leave it empty when the model carries its own dictionary.",
      "accept": [".txt"],
      "default": "",
      "when": {
        "setting": "model",
        "is": ["custom"]
      }
    },
    {
      "key": "dpi",
      "type": "enum",
      "title": "Scan resolution",
      "description": "Resolution a page is rendered at before recognition",
      "default": "300",
      "options": [
        {
          "value": "150",
          "title": "150 dpi"
        },
        {
          "value": "200",
          "title": "200 dpi"
        },
        {
          "value": "300",
          "title": "300 dpi"
        },
        {
          "value": "400",
          "title": "400 dpi"
        },
        {
          "value": "600",
          "title": "600 dpi"
        }
      ]
    },
    {
      "key": "recognizeAutomatically",
      "type": "boolean",
      "title": "Recognize automatically",
      "description": "Recognize every PDF and image in the vault that has no text",
      "default": false
    }
  ]
}
