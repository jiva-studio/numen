%PDF-1.4
% Three pages: the first with a line of text, the other two drawing a line each with no text layer,
% as a scanned book whose first page someone has already recognised.
1 0 obj << /Type /Catalog /Pages 2 0 R >> endobj
2 0 obj << /Type /Pages /Kids [3 0 R 5 0 R 7 0 R] /Count 3 >> endobj
3 0 obj << /Type /Page /Parent 2 0 R /MediaBox [0 0 200 200] /Contents 4 0 R /Resources << /Font << /F1 9 0 R >> >> >> endobj
4 0 obj << /Length 47 >>
stream
BT /F1 12 Tf 20 150 Td (Alpha beta gamma) Tj ET
endstream
endobj
5 0 obj << /Type /Page /Parent 2 0 R /MediaBox [0 0 200 200] /Contents 6 0 R >> endobj
6 0 obj << /Length 33 >>
stream
20 20 m 180 180 l 1 w S
endstream
endobj
7 0 obj << /Type /Page /Parent 2 0 R /MediaBox [0 0 200 200] /Contents 8 0 R >> endobj
8 0 obj << /Length 33 >>
stream
20 180 m 180 20 l 1 w S
endstream
endobj
9 0 obj << /Type /Font /Subtype /Type1 /BaseFont /Helvetica >> endobj
trailer << /Root 1 0 R /Size 10 >>
%%EOF
