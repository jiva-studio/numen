{
  "id": "md.numen.views.media.viewer",
  "name": "Audio Player & Recorder",
  "version": "2026.11.1",
  "protocol": 1,
  "description": "Audio and video player with interactive transcripts and voice recording",
  "targets": ["desktop.editor"],
  "contributes": {
    "tabKinds": [
      {
        "kind": "recording",
        "title": "Record Audio",
        "icon": "mic"
      },
      {
        "kind": "reader:media-viewer",
        "title": "Audio Player",
        "icon": "audio-lines"
      }
    ],
    "feature": "audio playback and recording",
    "category": "views",
    "readers": [
      {
        "id": "media-viewer",
        "contentTypes": [
          "audio/mpeg",
          "audio/mp4",
          "audio/vnd.wave",
          "audio/ogg",
          "audio/aac",
          "audio/flac"
        ],
        "rank": "default"
      }
    ],
    "commands": [
      {
        "id": "recording.create",
        "title": "Record audio",
        "icon": "mic"
      }
    ]
  },
  "permissions": ["vault:read", "vault:write"],
  "frontend": {}
}
