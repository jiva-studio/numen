{
  "id": "md.numen.views.plex.related.names",
  "name": "Plex Related Names",
  "version": "2026.11.1",
  "protocol": 1,
  "description": "Names of the notes related to the notes of the plex",
  "capabilities": [],
  "targets": ["desktop.editor"],
  "contributes": {
    "feature": "plex related names",
    "category": "views",
    "slots": [
      { "slot": "plexGraph.nodeAbove", "view": "parents" },
      { "slot": "plexGraph.nodeBelow", "view": "related" }
    ]
  },
  "permissions": ["vault:read"],
  "settings": [
    {
      "key": "namesPerNote",
      "type": "range",
      "title": "Names per note",
      "description": "Most names shown under and over a related note",
      "default": 6,
      "min": 1,
      "max": 12,
      "step": 1
    }
  ],
  "frontend": {}
}
