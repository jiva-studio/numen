{
  "id": "md.numen.views.media.player",
  "name": "Audio Player & Recorder",
  "version": "2026.11.3",
  "protocol": 1,
  "description": "Audio and video player with interactive transcripts and voice recording",
  "targets": ["desktop.editor"],
  "contributes": {
    "tabKinds": [
      { "kind": "recording", "title": "Record Audio", "icon": "mic" },
      { "kind": "reader:media-player", "title": "Audio Player", "icon": "audio-lines" }
    ],
    "feature": "audio playback and recording",
    "category": "views",
    "readers": [
      {
        "id": "media-player",
        "contentTypes": [
          "audio/mpeg",
          "audio/mp4",
          "audio/vnd.wave",
          "audio/ogg",
          "audio/aac",
          "audio/flac"
        ],
        "rank": "default"
      }
    ]
  },
  "permissions": ["vault:read", "vault:write"],
  "frontend": {}
}
