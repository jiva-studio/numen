{
  "id": "md.numen.views.media.player",
  "name": "Audio Player & Recorder",
  "version": "2026.10.2",
  "protocol": 1,
  "description": "Audio and video player with interactive transcripts and voice recording",
  "capabilities": ["audio", "recording"],
  "targets": ["desktop.editor"],
  "permissions": ["vault:read", "vault:write"],
  "readers": [
    {
      "id": "media-player",
      "contentTypes": [
        "audio/mpeg",
        "audio/mp4",
        "audio/vnd.wave",
        "audio/ogg",
        "audio/aac",
        "audio/flac"
      ],
      "rank": "default"
    }
  ],
  "activationEvents": [],
  "frontend": {
    "entrypoint": "dist/index.js",
    "styles": "dist/styles.css"
  }
}
