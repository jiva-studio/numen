{
  "id": "md.numen.agents.mcp.server",
  "name": "Model Context Protocol Server",
  "version": "2026.11.7",
  "protocol": 1,
  "description": "Connects external AI apps to your open vault",
  "capabilities": [],
  "targets": ["desktop.editor"],
  "contributes": {
    "category": "agents",
    "listeners": [{ "name": "mcp", "port": 3333, "protocol": "tcp" }]
  },
  "permissions": ["vault:read", "vault:write", "network:outbound"],
  "backend": { "entrypoint": "bin/agents-mcp-server" },
  "services": ["md.numen.agents.mcp.server"]
}
