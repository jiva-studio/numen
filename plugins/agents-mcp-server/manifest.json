{
  "id": "md.numen.agents.mcp.server",
  "name": "Model Context Protocol Server",
  "version": "2026.11.16",
  "protocol": 1,
  "description": "Connects external AI apps to your open vault",
  "capabilities": [],
  "targets": ["desktop.editor"],
  "contributes": {
    "category": "agents",
    "listeners": [{ "name": "mcp", "portSetting": "port", "protocol": "tcp" }]
  },
  "permissions": [
    "vault:read",
    "vault:write",
    "vault:manage",
    "window:focus",
    "index:read",
    "link:open"
  ],
  "backend": { "entrypoint": "bin/agents-mcp-server" },
  "services": ["md.numen.agents.mcp.server"],
  "settings": [
    {
      "key": "port",
      "type": "number",
      "title": "Port",
      "description": "Port on 127.0.0.1 MCP clients connect to, at /mcp",
      "default": 3333,
      "min": 1024,
      "max": 65535,
      "step": 1
    },
    {
      "key": "token",
      "type": "string",
      "title": "Token",
      "description": "Bearer token MCP clients send; made on first start. Empty rejects every request",
      "generate": "token"
    }
  ]
}
