{
  "id": "md.numen.agents.mcp.server",
  "name": "Model Context Protocol Server",
  "version": "2026.10.2",
  "protocol": 1,
  "description": "Connects external AI apps to your open vault",
  "capabilities": [],
  "targets": ["desktop.editor"],
  "contributes": { "category": "agents" },
  "activationEvents": ["*"],
  "permissions": ["vault:read", "vault:write", "network:outbound"],
  "lifecycle": {
    "idleTimeoutSeconds": 0,
    "memoryLimitBytes": 134217728
  },
  "backend": {
    "type": "process",
    "entrypoint": "bin/agents-mcp-server",
    "serviceName": "numen.v1.McpServerService"
  },
  "settings": [
    {
      "key": "port",
      "type": "number",
      "title": "Port",
      "description": "Local TCP port on 127.0.0.1 for external MCP clients (Streamable HTTP at /mcp and SSE at /sse)",
      "default": 3333,
      "min": 1024,
      "max": 65535,
      "step": 1
    }
  ]
}
