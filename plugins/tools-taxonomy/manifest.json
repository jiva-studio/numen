{
  "id": "md.numen.tools.taxonomy",
  "name": "Taxonomy",
  "version": "2026.11.6",
  "protocol": 1,
  "description": "Reads and sets the tags of notes in their frontmatter, finds notes by tag in queries and lists the tags for agents",
  "capabilities": ["tools"],
  "targets": ["desktop.editor"],
  "activationEvents": ["onFilesChanged:text/markdown"],
  "contributes": {
    "category": "tools",
    "commands": [{ "id": "tags.set", "title": "Set tags", "icon": "tag", "when": "target.isNote" }],
    "slots": [
      { "slot": "fileTree.rowEnd", "view": "file-tags" },
      {
        "slot": "fileTree.context",
        "command": "tags.set",
        "group": "2-edit",
        "order": 15,
        "when": "target.isNote"
      },
      { "slot": "plexGraph.context", "command": "tags.set", "group": "3-plex", "order": 50 },
      { "slot": "plexGraph.nodeBelow", "view": "plex-tags" }
    ],
    "searchFunctions": {
      "version": 1,
      "functions": [
        {
          "name": "tags",
          "args": [{ "name": "tag", "type": "string" }],
          "level": "document",
          "description": "notes with the tag or a tag nested under it in the frontmatter key tags, compared without case; a leading # is dropped",
          "example": "tags(\"Projects\") && meaning(\"deadline\")"
        },
        {
          "name": "isTagged",
          "args": [],
          "level": "document",
          "description": "notes with at least one tag in the frontmatter key tags",
          "example": "!isTagged() && kind == \"note\""
        }
      ]
    }
  },
  "permissions": ["vault:read", "vault:write"],
  "services": ["md.numen.tools.taxonomy"],
  "backend": { "entrypoint": "bin/tools-taxonomy" },
  "frontend": {}
}
