{
  "id": "md.numen.views.plex.graph",
  "name": "Plex Graph",
  "version": "2026.11.23",
  "protocol": 1,
  "description": "Interactive visual map of connected notes and topics",
  "capabilities": [],
  "targets": ["desktop.editor"],
  "contributes": {
    "tabKinds": [
      {
        "kind": "plex",
        "title": "Plex",
        "icon": "waypoints"
      }
    ],
    "feature": "plex graph",
    "category": "views",
    "commands": [
      {
        "id": "graph.open",
        "title": "Open plex graph",
        "icon": "waypoints",
        "when": "window.isVaultOpen"
      }
    ],
    "slots": [
      {
        "slot": "palette.searchResult",
        "command": "app:file.reveal",
        "values": { "kind": "plex" },
        "title": "Show in plex",
        "icon": "waypoints",
        "group": "navigate",
        "order": 20,
        "when": "target.isNote"
      },
      {
        "slot": "palette.note",
        "command": "app:file.reveal",
        "values": { "kind": "plex" },
        "title": "Show in plex",
        "icon": "waypoints",
        "when": "target.isNote"
      },
      { "slot": "titleBar.commands", "command": "graph.open", "group": "navigate", "order": 20 },
      {
        "slot": "fileTree.context",
        "command": "app:file.reveal",
        "values": { "kind": "plex" },
        "title": "Show in plex",
        "icon": "waypoints",
        "group": "0-open",
        "order": 20,
        "when": "target.isNote"
      },
      {
        "slot": "fileTree.context",
        "submenu": "plex.relation",
        "title": "Relation",
        "icon": "waypoints",
        "group": "4-relation"
      },
      { "slot": "plex.relation", "command": "app:note.createChild", "order": 10 },
      { "slot": "plex.relation", "command": "app:note.createParent", "order": 20 },
      { "slot": "plex.relation", "command": "app:note.createJump", "order": 30 },
      {
        "slot": "plexGraph.context",
        "command": "app:note.create",
        "group": "0-new",
        "order": 10,
        "when": "target.isFolder"
      },
      { "slot": "plexGraph.context", "command": "app:file.open", "group": "0-open", "order": 10 },
      {
        "slot": "plexGraph.context",
        "command": "app:file.reveal",
        "values": { "kind": "plex" },
        "title": "Show in plex",
        "icon": "waypoints",
        "group": "1-note",
        "order": 10,
        "when": "target.isNote"
      },
      {
        "slot": "plexGraph.context",
        "command": "app:file.copyPath",
        "group": "2-file",
        "order": 10
      },
      {
        "slot": "plexGraph.context",
        "command": "app:note.createChild",
        "group": "3-plex",
        "order": 10
      },
      {
        "slot": "plexGraph.context",
        "command": "app:note.createParent",
        "group": "3-plex",
        "order": 20
      },
      {
        "slot": "plexGraph.context",
        "command": "app:note.createJump",
        "group": "3-plex",
        "order": 30
      },
      { "slot": "plexGraph.context", "command": "app:note.rename", "group": "3-plex", "order": 40 },
      { "slot": "plexGraph.context", "command": "app:file.remove", "group": "9-remove" }
    ],
    "keybindings": [
      { "key": "mod+shift+x", "command": "graph.open" },
      {
        "key": "mod+shift+p",
        "command": "app:file.reveal",
        "values": { "kind": "plex" },
        "when": "target.isNote"
      }
    ]
  },
  "permissions": ["vault:read", "vault:write"],
  "settings": [
    {
      "key": "references",
      "type": "enum",
      "title": "References",
      "description": "Notes linked in the text, by direction",
      "default": "both",
      "options": [
        {
          "value": "off",
          "title": "Off"
        },
        {
          "value": "outgoing",
          "title": "Outgoing"
        },
        {
          "value": "incoming",
          "title": "Incoming"
        },
        {
          "value": "both",
          "title": "Both"
        }
      ],
      "details": "Show the notes linked in the text: the ones this note links to, the ones that link to it, both, or none."
    },
    {
      "key": "nestHeadings",
      "type": "boolean",
      "title": "Nest headings under notes",
      "description": "Show the headings of a note under its node",
      "default": true,
      "palette": true,
      "icon": "waypoints"
    },
    {
      "key": "headingLimit",
      "type": "range",
      "title": "Headings per note",
      "description": "Most headings shown under a node",
      "default": 6,
      "min": 1,
      "max": 12,
      "step": 1
    },
    {
      "key": "showNames",
      "type": "boolean",
      "title": "Show notes related to related notes",
      "description": "Under each related note, the names of the notes related to it",
      "default": true,
      "palette": true,
      "icon": "waypoints"
    },
    {
      "key": "namesPerNote",
      "type": "range",
      "title": "Names per note",
      "description": "Most names shown under and over a related note",
      "default": 6,
      "min": 1,
      "max": 12,
      "step": 1
    },
    {
      "key": "namesOpacity",
      "type": "range",
      "title": "Names opacity",
      "description": "Opacity of the names while the note is not in focus",
      "default": 0.7,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "details": "How visible the names under and over a note are while the note is not in focus. 0 hides them."
    },
    {
      "key": "focusedNamesOpacity",
      "type": "range",
      "title": "Names opacity in focus",
      "details": "How visible the names under and over a note are while the pointer is over the note or one of them.",
      "default": 1,
      "min": 0.05,
      "max": 1,
      "step": 0.05,
      "details": "How visible the names under and over a note are while the pointer is over the note or one of them."
    },
    {
      "key": "showPills",
      "type": "boolean",
      "title": "Pill background",
      "description": "Draw a pill behind each title",
      "default": true,
      "palette": true,
      "icon": "waypoints",
      "details": "Draw a pill behind each title. Off: the title alone."
    },
    {
      "key": "pillPaddingSides",
      "type": "range",
      "title": "Pill padding, sides",
      "description": "Space beside the title inside its pill",
      "default": 10,
      "min": 0,
      "max": 24,
      "step": 1
    },
    {
      "key": "pillPaddingEnds",
      "type": "range",
      "title": "Pill padding, top and bottom",
      "description": "Space above and below the title inside its pill",
      "default": 9.25,
      "min": 0,
      "max": 16,
      "step": 0.25
    },
    {
      "key": "focusSize",
      "type": "range",
      "title": "Focus size",
      "description": "How much larger the middle note is drawn",
      "default": 1.22,
      "min": 1,
      "max": 2.5,
      "step": 0.01,
      "details": "How much larger the note in the middle is drawn: its pill, title and icon."
    },
    {
      "key": "lineThickness",
      "type": "range",
      "title": "Line thickness",
      "description": "Width of the lines between notes, in pixels.",
      "default": 2,
      "min": 0.5,
      "max": 4,
      "step": 0.25
    },
    {
      "key": "outlineThickness",
      "type": "range",
      "title": "Outline thickness",
      "description": "Width of the outline of a pill, in pixels.",
      "default": 1,
      "min": 0.5,
      "max": 4,
      "step": 0.25
    },
    {
      "key": "lineCurvature",
      "type": "range",
      "title": "Line curvature",
      "description": "How far lines bend; 0 is straight",
      "default": 0.55,
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    {
      "key": "highlightLinks",
      "type": "boolean",
      "title": "Highlight links of a hovered note",
      "description": "Highlight the lines of a note while the pointer is over it",
      "default": true,
      "palette": true,
      "icon": "waypoints",
      "details": "Highlight every line that joins a note while the pointer is over it. Off: only a line the pointer is over is highlighted."
    },
    {
      "key": "animationLength",
      "type": "range",
      "title": "Animation",
      "description": "Time to move to another note, in ms; 0 is instant",
      "default": 420,
      "min": 0,
      "max": 2000,
      "step": 20
    },
    {
      "key": "noteRoom",
      "type": "range",
      "title": "Room around a note",
      "description": "Empty space around every note",
      "default": 0,
      "min": 0,
      "max": 40,
      "step": 1
    }
  ],
  "frontend": {}
}
