{
  "id": "md.numen.views.plex.graph",
  "name": "Plex Graph",
  "version": "2026.10.2",
  "protocol": 1,
  "description": "Interactive visual map of connected notes and topics",
  "capabilities": [],
  "targets": ["desktop.editor"],
  "contributes": {
    "tabKinds": [{ "kind": "plex", "title": "Plex", "icon": "waypoints" }],
    "feature": "plex graph",
    "category": "views"
  },
  "activationEvents": [],
  "permissions": ["vault:read", "vault:write"],
  "settings": [
    {
      "key": "nest_headings",
      "type": "boolean",
      "title": "Nest headings under notes",
      "description": "Show the headings of a note under its node.",
      "default": true,
      "palette": true,
      "icon": "waypoints"
    },
    {
      "key": "heading_limit",
      "type": "number",
      "title": "Headings per note",
      "description": "Maximum number of headings shown under a node. The rest scroll.",
      "default": 6,
      "min": 1,
      "max": 12,
      "step": 1
    }
  ],
  "frontend": {
    "entrypoint": "dist/index.js",
    "styles": "dist/styles.css"
  }
}
