{
  "id": "md.numen.engines.embeddings",
  "name": "Vector Embeddings",
  "version": "1.0.0",
  "protocol": 1,
  "description": "Vector embeddings engine for semantic search",
  "capabilities": ["embedding"],
  "targets": ["desktop.editor"],
  "activationEvents": ["*"],
  "permissions": ["vault:read", "network:outbound"],
  "dependencies": [
    {
      "id": "onnxruntime",
      "kind": "runtime"
    }
  ],
  "secrets": [{ "name": "apiKey", "title": "API key" }],
  "lifecycle": {
    "idleTimeoutSeconds": 0,
    "keepAliveWhileVisible": true,
    "memoryLimitBytes": 2147483648
  },
  "backend": {
    "type": "process",
    "entrypoint": "bin/engines-embeddings",
    "serviceName": "numen.v1.EmbeddingService"
  },
  "settings": [
    {
      "key": "provider",
      "type": "enum",
      "title": "Embedding Provider",
      "description": "Embedding provider engine (local on-device or remote service)",
      "options": ["local", "openrouter", "openai", "custom"],
      "default": "local"
    },
    {
      "key": "baseUrl",
      "type": "string",
      "title": "Service URL",
      "description": "Base URL for OpenAI-compatible embeddings API",
      "default": "https://openrouter.ai/api/v1"
    },
    {
      "key": "model",
      "type": "string",
      "title": "Model",
      "description": "Model name for embeddings",
      "default": "text-embedding-3-small"
    }
  ]
}
