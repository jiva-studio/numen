  "backend": {
    "entrypoint": "bin/engines-embeddings",
    "idleStopSeconds": 600
  },
  "settings": [
    {
      "key": "source",
      "type": "enum",
      "title": "Source",
      "description": "Where texts are turned into vectors",
      "default": "local",
      "options": [
        {
          "value": "local",
          "title": "Local model",
          "detail": "Runs an embedding model on this machine"
        },
        {
          "value": "connection",
          "title": "Connection",
          "detail": "Sends the texts to a service through a connection"
        }
      ]
    },
    {
      "key": "model",
      "type": "string",
      "title": "Model",
      "description": "Local embedding model from Hugging Face; it needs a profile",
      "default": "Xenova/multilingual-e5-small",
      "options": [
        {
          "value": "Xenova/multilingual-e5-small",
          "dependencies": ["e5-small-graph", "e5-small-tokenizer"],
          "title": "E5 small (default, CPU, 118 MB)",
          "detail": "384 dims · Hugging Face"
        },
        {
          "value": "onnx-community/harrier-oss-v1-270m-ONNX",
          "dependencies": [
            "harrier-270m-graph",
            "harrier-270m-graph-data",
            "harrier-270m-tokenizer"
          ],
          "title": "Harrier 270M (better, 344 MB)",
          "detail": "640 dims · Hugging Face"
        },
        {
          "value": "Xenova/bge-m3",
          "dependencies": ["bge-m3-graph", "bge-m3-tokenizer"],
          "title": "BGE-M3 (large, 569 MB)",
          "detail": "1024 dims · Hugging Face"
        }
      ],
      "when": {
        "setting": "source",
        "is": ["local"]
      }
    },
    {
      "key": "connections",
      "type": "connections",
      "title": "Connection",
      "description": "A new connection or model reindexes the vault",
      "operations": ["llm.embed", "llm.profile"],
      "max": 1,
      "when": {
        "setting": "source",
        "is": ["connection"]
      }
    },
    {
      "key": "minChunkLength",
      "type": "number",
      "title": "Smallest piece of text to index for meaning",
      "description": "Fewest characters a piece of text needs for a vector",
      "details": "The fewest characters a piece of text needs to get a vector. Shorter pieces are found by their words only.",
      "default": 40,
      "min": 0,
      "max": 1000,
      "step": 1
    },
    {
      "key": "chunkTokens",
      "type": "number",
      "title": "Longest chunk of a note, in tokens",
      "description": "Largest piece of a note, in tokens, that gets one vector",
      "default": 256,
      "min": 16,
      "max": 8192,
      "step": 1
    }
  ]
}
