{
  "id": "md.numen.engines.embeddings",
  "name": "Vector Embeddings",
  "version": "2026.10.1",
  "protocol": 1,
  "description": "Meaning-based search across your notes, books, and recordings",
  "capabilities": ["embedding"],
  "targets": ["desktop.editor"],
  "activationEvents": ["*"],
  "permissions": ["vault:read", "network:outbound"],
  "dependencies": [
    {
      "id": "onnxruntime",
      "kind": "runtime"
    }
  ],
  "secrets": [
    {
      "name": "apiKey",
      "title": "API key",
      "description": "Key of the remote service",
      "when": {
        "setting": "provider",
        "is": ["openrouter", "openai", "custom"]
      }
    }
  ],
  "lifecycle": {
    "idleTimeoutSeconds": 0,
    "keepAliveWhileVisible": true,
    "memoryLimitBytes": 2147483648
  },
  "backend": {
    "type": "process",
    "entrypoint": "bin/engines-embeddings"
  },
  "settings": [
    {
      "key": "provider",
      "type": "enum",
      "title": "Provider",
      "description": "Where texts are turned into vectors",
      "default": "local",
      "options": [
        {
          "value": "local",
          "title": "Local",
          "detail": "Runs ONNX embedding models locally on this machine"
        },
        {
          "value": "openrouter",
          "title": "OpenRouter",
          "detail": "OpenRouter embeddings API"
        },
        {
          "value": "openai",
          "title": "OpenAI",
          "detail": "OpenAI embeddings API"
        },
        {
          "value": "custom",
          "title": "Custom service",
          "detail": "Any OpenAI-compatible embeddings API"
        }
      ]
    },
    {
      "key": "baseUrl",
      "type": "string",
      "title": "Service URL",
      "description": "Base URL of the embeddings API, for example https://example.org/v1",
      "default": "",
      "when": {
        "setting": "provider",
        "is": ["custom"]
      }
    },
    {
      "key": "model",
      "type": "string",
      "title": "Model",
      "description": "Model identifier. Local models are downloaded from Hugging Face (<org>/<repo> containing onnx/model.onnx and tokenizer.json); remote providers use the model ID listed by the service.",
      "default": "Xenova/bge-m3",
      "optionsBy": {
        "setting": "provider",
        "options": {
          "local": [
            {
              "value": "Xenova/bge-m3",
              "title": "BGE-M3 (int8)",
              "detail": "100+ languages, 1024 dims · Hugging Face"
            },
            {
              "value": "Xenova/multilingual-e5-small",
              "title": "Multilingual E5 Small",
              "detail": "100 languages, 384 dims · Hugging Face"
            },
            {
              "value": "Xenova/bge-small-en-v1.5",
              "title": "BGE Small English v1.5",
              "detail": "English, 384 dims · Hugging Face"
            }
          ],
          "openrouter": [
            {
              "value": "openai/text-embedding-3-small",
              "title": "OpenAI: text-embedding-3-small",
              "detail": "1536 dims · OpenRouter"
            },
            {
              "value": "openai/text-embedding-3-large",
              "title": "OpenAI: text-embedding-3-large",
              "detail": "3072 dims · OpenRouter"
            },
            { "value": "baai/bge-m3", "title": "BAAI: BGE-M3", "detail": "1024 dims · OpenRouter" },
            {
              "value": "qwen/qwen3-embedding-8b",
              "title": "Qwen3 Embedding 8B",
              "detail": "4096 dims · OpenRouter"
            }
          ],
          "openai": [
            {
              "value": "text-embedding-3-small",
              "title": "text-embedding-3-small",
              "detail": "1536 dims · OpenAI"
            },
            {
              "value": "text-embedding-3-large",
              "title": "text-embedding-3-large",
              "detail": "3072 dims · OpenAI"
            },
            {
              "value": "text-embedding-ada-002",
              "title": "text-embedding-ada-002",
              "detail": "1536 dims · OpenAI"
            }
          ],
          "custom": [
            {
              "value": "text-embedding-3-small",
              "title": "text-embedding-3-small",
              "detail": "OpenAI-compatible model ID"
            }
          ]
        }
      }
    }
  ]
}
