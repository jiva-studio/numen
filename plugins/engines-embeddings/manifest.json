{
  "id": "md.numen.engines.embeddings",
  "name": "Vector Embeddings",
  "version": "1.0.0",
  "protocol": 1,
  "description": "Vector embeddings engine for semantic search",
  "capabilities": ["embedding"],
  "targets": ["desktop.editor"],
  "activationEvents": ["*"],
  "permissions": ["vault:read", "network:outbound"],
  "dependencies": [
    {
      "id": "onnxruntime",
      "kind": "runtime"
    }
  ],
  "secrets": [
    {
      "name": "apiKey",
      "title": "API key",
      "description": "Key of the remote service",
      "when": {
        "setting": "provider",
        "is": ["openrouter", "openai", "custom"]
      }
    }
  ],
  "lifecycle": {
    "idleTimeoutSeconds": 0,
    "keepAliveWhileVisible": true,
    "memoryLimitBytes": 2147483648
  },
  "backend": {
    "type": "process",
    "entrypoint": "bin/engines-embeddings",
    "serviceName": "numen.v1.EmbeddingService"
  },
  "settings": [
    {
      "key": "provider",
      "type": "enum",
      "title": "Provider",
      "description": "Where texts are turned into vectors",
      "default": "local",
      "options": [
        {
          "value": "local",
          "title": "Local",
          "detail": "BGE-M3 on this machine: 100+ languages, 1024 dimensions"
        },
        {
          "value": "openrouter",
          "title": "OpenRouter",
          "detail": "OpenRouter embeddings API"
        },
        {
          "value": "openai",
          "title": "OpenAI",
          "detail": "OpenAI embeddings API"
        },
        {
          "value": "custom",
          "title": "Custom service",
          "detail": "Any OpenAI-compatible embeddings API"
        }
      ]
    },
    {
      "key": "baseUrl",
      "type": "string",
      "title": "Service URL",
      "description": "Base URL of the embeddings API, for example https://example.org/v1",
      "default": "",
      "when": {
        "setting": "provider",
        "is": ["custom"]
      }
    },
    {
      "key": "model",
      "type": "string",
      "title": "Model",
      "description": "Model name the service lists, for example text-embedding-3-small",
      "default": "text-embedding-3-small",
      "when": {
        "setting": "provider",
        "is": ["openrouter", "openai", "custom"]
      }
    }
  ]
}
