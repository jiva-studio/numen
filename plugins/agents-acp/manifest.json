{
  "id": "md.numen.agents.acp",
  "name": "ACP Agents",
  "version": "2026.11.13",
  "protocol": 1,
  "description": "External AI assistants via the Agent Client Protocol",
  "capabilities": ["ai.agent.provider"],
  "targets": ["desktop.editor", "desktop.flashcards"],
  "contributes": {
    "category": "agents",
    "connectionTypes": [
      {
        "id": "acp",
        "title": "ACP agent",
        "operations": ["complete"],
        "fields": [
          { "key": "program", "type": "file", "title": "Program", "required": true },
          {
            "key": "parallelRequests",
            "type": "number",
            "title": "Parallel requests",
            "default": 1,
            "min": 1,
            "max": 8,
            "step": 1
          }
        ]
      }
    ]
  },
  "permissions": [
    "link:open",
    "vault:read",
    "vault:write",
    "vault:manage",
    "window:focus",
    "index:read"
  ],
  "backend": { "entrypoint": "bin/agents-acp" },
  "services": ["numen.v1.AgentService", "numen.v1.ProviderService"],
  "settings": [
    {
      "key": "executablePath",
      "type": "file",
      "multiple": true,
      "title": "Executable Paths",
      "description": "Installed ACP agents are discovered automatically. Choose one or more custom ACP agent executables to add them.",
      "default": ""
    },
    {
      "key": "requestTimeout",
      "type": "number",
      "title": "Request timeout",
      "description": "Seconds to wait for the program to answer a request from a connection. Without a value, a request waits 120 seconds.",
      "min": 1,
      "max": 3600,
      "step": 1
    }
  ]
}
