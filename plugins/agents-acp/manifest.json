{
  "id": "md.numen.agents.acp",
  "name": "ACP Agents",
  "version": "2026.11.11",
  "protocol": 1,
  "description": "External AI assistants via the Agent Client Protocol",
  "capabilities": ["ai.agent.provider"],
  "targets": ["desktop.editor", "desktop.flashcards"],
  "contributes": { "category": "agents" },
  "permissions": [
    "link:open",
    "vault:read",
    "vault:write",
    "vault:manage",
    "window:focus",
    "index:read"
  ],
  "backend": { "entrypoint": "bin/agents-acp" },
  "services": ["numen.v1.AgentService"],
  "settings": [
    {
      "key": "executablePath",
      "type": "file",
      "multiple": true,
      "title": "Executable Paths",
      "description": "Installed ACP agents are discovered automatically. Choose one or more custom ACP agent executables to add them.",
      "default": ""
    }
  ]
}
