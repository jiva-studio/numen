{
  "id": "md.numen.agents.acp",
  "name": "ACP Agents",
  "version": "2026.11.13",
  "protocol": 1,
  "description": "External AI assistants via the Agent Client Protocol: Claude Code, Codex, Antigravity and any other ACP program",
  "targets": ["desktop.editor", "desktop.flashcards"],
  "contributes": {
    "category": "agents",
    "operations": [{ "name": "acp.task", "title": "run agent tasks" }],
    "connectionTypes": [
      {
        "id": "acp",
        "title": "ACP agent",
        "operations": ["llm.complete", "llm.models", "llm.reasoning", "acp.task"],
        "rowFields": [
          {
            "key": "model",
            "type": "string",
            "title": "Model",
            "required": true,
            "optionsFrom": "llm.models"
          },
          {
            "key": "reasoning",
            "type": "enum",
            "title": "Reasoning",
            "optionsFrom": "llm.reasoning"
          }
        ],
        "fields": [
          { "key": "program", "type": "file", "title": "Program", "required": true },
          {
            "key": "parallelRequests",
            "type": "number",
            "title": "Parallel requests",
            "default": 1,
            "min": 1,
            "max": 8,
            "step": 1
          }
        ]
      },
      {
        "id": "claude-code",
        "title": "Claude Code",
        "operations": ["llm.complete", "llm.models", "llm.reasoning", "acp.task"],
        "rowFields": [
          {
            "key": "model",
            "type": "string",
            "title": "Model",
            "required": true,
            "optionsFrom": "llm.models"
          },
          {
            "key": "reasoning",
            "type": "enum",
            "title": "Reasoning",
            "optionsFrom": "llm.reasoning"
          }
        ],
        "fields": [
          { "key": "program", "type": "file", "title": "Program" },
          {
            "key": "parallelRequests",
            "type": "number",
            "title": "Parallel requests",
            "default": 1,
            "min": 1,
            "max": 8,
            "step": 1
          }
        ]
      },
      {
        "id": "codex",
        "title": "OpenAI Codex",
        "operations": ["llm.complete", "llm.models", "llm.reasoning", "acp.task"],
        "rowFields": [
          {
            "key": "model",
            "type": "string",
            "title": "Model",
            "required": true,
            "optionsFrom": "llm.models"
          },
          {
            "key": "reasoning",
            "type": "enum",
            "title": "Reasoning",
            "optionsFrom": "llm.reasoning"
          }
        ],
        "fields": [
          { "key": "program", "type": "file", "title": "Program" },
          {
            "key": "parallelRequests",
            "type": "number",
            "title": "Parallel requests",
            "default": 1,
            "min": 1,
            "max": 8,
            "step": 1
          }
        ]
      },
      {
        "id": "antigravity",
        "title": "Antigravity",
        "operations": ["llm.complete", "llm.models", "llm.reasoning", "acp.task"],
        "rowFields": [
          {
            "key": "model",
            "type": "string",
            "title": "Model",
            "required": true,
            "optionsFrom": "llm.models"
          },
          {
            "key": "reasoning",
            "type": "enum",
            "title": "Reasoning",
            "optionsFrom": "llm.reasoning"
          }
        ],
        "fields": [
          { "key": "program", "type": "file", "title": "Program" },
          {
            "key": "parallelRequests",
            "type": "number",
            "title": "Parallel requests",
            "default": 1,
            "min": 1,
            "max": 8,
            "step": 1
          }
        ]
      }
    ]
  },
  "permissions": [
    "link:open",
    "vault:read",
    "vault:write",
    "vault:manage",
    "window:focus",
    "index:read"
  ],
  "backend": { "entrypoint": "bin/agents-acp" },
  "services": ["numen.v1.ProviderService"],
  "settings": [
    {
      "key": "requestTimeout",
      "type": "number",
      "title": "Request timeout",
      "description": "Seconds to wait for the program to answer a request from a connection, or to open the session of a task. Without a value, it waits 120 seconds.",
      "min": 1,
      "max": 3600,
      "step": 1
    }
  ]
}
