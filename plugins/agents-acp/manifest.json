{
  "id": "md.numen.agents.acp",
  "name": "ACP Agents",
  "version": "2026.10.1",
  "protocol": 1,
  "description": "External AI assistants via the Agent Client Protocol",
  "capabilities": ["agent", "ai.agent.provider"],
  "targets": ["desktop.editor", "desktop.flashcards"],
  "permissions": ["network:outbound", "vault:read", "vault:write"],
  "lifecycle": {
    "idleTimeoutSeconds": 180,
    "keepAliveWhileVisible": false,
    "memoryLimitBytes": 4294967296
  },
  "backend": {
    "type": "process",
    "entrypoint": "bin/agents-acp",
    "serviceName": "numen.v1.AgentService"
  },
  "settings": [
    {
      "key": "executable_path",
      "type": "file",
      "title": "Executable Paths",
      "description": "Installed ACP agents are discovered automatically. Choose one or more custom ACP agent executables to add them.",
      "default": ""
    }
  ]
}
