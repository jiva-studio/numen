{
  "id": "md.numen.connections.llm",
  "name": "Language model services",
  "version": "2026.11.3",
  "protocol": 1,
  "description": "Connects Numen to OpenRouter, OpenAI and OpenAI-compatible servers for completions, chat and embeddings",
  "targets": ["desktop.editor", "desktop.flashcards"],
  "contributes": {
    "category": "connections",
    "operations": [
      { "name": "llm.complete", "title": "complete text" },
      { "name": "llm.chat", "title": "chat" },
      { "name": "llm.embed", "title": "embed text" },
      { "name": "llm.profile", "title": "describe a model" },
      { "name": "llm.models", "title": "list models" },
      { "name": "llm.reasoning", "title": "list reasoning levels" }
    ],
    "connectionTypes": [
      {
        "id": "openrouter",
        "title": "OpenRouter",
        "description": "One key for many models.",
        "operations": [
          "llm.complete",
          "llm.chat",
          "llm.embed",
          "llm.profile",
          "llm.models",
          "llm.reasoning"
        ],
        "rowFields": [
          {
            "key": "model",
            "type": "string",
            "title": "Model",
            "required": true,
            "optionsFrom": "llm.models"
          },
          {
            "key": "reasoning",
            "type": "enum",
            "title": "Reasoning",
            "optionsFrom": "llm.reasoning"
          }
        ],
        "fields": [
          {
            "key": "baseUrl",
            "type": "string",
            "title": "Address",
            "isAddress": true,
            "fixedValue": "https://openrouter.ai/api/v1"
          },
          { "key": "apiKey", "type": "secret", "title": "API key", "required": true },
          {
            "key": "parallelRequests",
            "type": "number",
            "title": "Parallel requests",
            "default": 4,
            "min": 1,
            "max": 32,
            "step": 1
          }
        ]
      },
      {
        "id": "openai",
        "title": "OpenAI",
        "description": "Models from OpenAI.",
        "operations": [
          "llm.complete",
          "llm.chat",
          "llm.embed",
          "llm.profile",
          "llm.models",
          "llm.reasoning"
        ],
        "rowFields": [
          {
            "key": "model",
            "type": "string",
            "title": "Model",
            "required": true,
            "optionsFrom": "llm.models"
          },
          {
            "key": "reasoning",
            "type": "enum",
            "title": "Reasoning",
            "optionsFrom": "llm.reasoning"
          }
        ],
        "fields": [
          {
            "key": "baseUrl",
            "type": "string",
            "title": "Address",
            "isAddress": true,
            "fixedValue": "https://api.openai.com/v1"
          },
          { "key": "apiKey", "type": "secret", "title": "API key", "required": true },
          {
            "key": "parallelRequests",
            "type": "number",
            "title": "Parallel requests",
            "default": 4,
            "min": 1,
            "max": 32,
            "step": 1
          }
        ]
      },
      {
        "id": "openai-compatible",
        "title": "OpenAI-compatible server",
        "description": "A server with the OpenAI API, such as Ollama or LM Studio.",
        "operations": [
          "llm.complete",
          "llm.chat",
          "llm.embed",
          "llm.profile",
          "llm.models",
          "llm.reasoning"
        ],
        "rowFields": [
          {
            "key": "model",
            "type": "string",
            "title": "Model",
            "required": true,
            "optionsFrom": "llm.models"
          },
          {
            "key": "reasoning",
            "type": "enum",
            "title": "Reasoning",
            "optionsFrom": "llm.reasoning"
          }
        ],
        "fields": [
          {
            "key": "baseUrl",
            "type": "string",
            "title": "Address",
            "description": "For example http://localhost:11434/v1",
            "isAddress": true,
            "required": true
          },
          { "key": "apiKey", "type": "secret", "title": "API key" },
          {
            "key": "parallelRequests",
            "type": "number",
            "title": "Parallel requests",
            "default": 4,
            "min": 1,
            "max": 32,
            "step": 1
          }
        ]
      }
    ]
  },
  "services": ["numen.v1.ProviderService"],
  "settings": [
    {
      "key": "requestTimeout",
      "type": "number",
      "title": "Request timeout",
      "description": "Seconds to wait; empty waits 120, or 60 for embeddings",
      "min": 1,
      "max": 3600,
      "step": 1
    }
  ],
  "backend": {
    "entrypoint": "bin/connections-llm"
  }
}
