{
  "id": "md.numen.agents.numen",
  "name": "Numen Agent",
  "version": "2026.11.12",
  "protocol": 1,
  "description": "Built-in AI assistant that chats through a connection to OpenRouter, OpenAI or an OpenAI-compatible server",
  "targets": ["desktop.editor", "desktop.flashcards"],
  "contributes": {
    "category": "agents",
    "operations": [{ "name": "acp.task", "title": "run agent tasks" }],
    "connectionTypes": [
      {
        "id": "numen",
        "title": "Numen agent",
        "operations": ["acp.task"],
        "fields": [
          {
            "key": "parallelRequests",
            "type": "number",
            "title": "Parallel requests",
            "default": 1,
            "min": 1,
            "max": 8,
            "step": 1
          }
        ]
      }
    ]
  },
  "permissions": ["vault:read", "vault:write", "vault:manage", "window:focus", "index:read"],
  "backend": { "entrypoint": "bin/agents-numen" },
  "services": ["numen.v1.ProviderService"],
  "settings": [
    {
      "key": "connections",
      "type": "connections",
      "title": "Connection",
      "description": "The service the agent chats through, with its model and reasoning level.",
      "operations": ["llm.chat"],
      "max": 1
    },
    {
      "key": "temperature",
      "type": "range",
      "title": "Temperature",
      "description": "Sampling temperature for model responses (0.0 to 1.0)",
      "default": 0.7,
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    {
      "key": "maxTokens",
      "type": "number",
      "title": "Max Tokens",
      "description": "Maximum number of tokens to generate per completion",
      "default": 4096,
      "min": 256,
      "max": 128000,
      "step": 256
    },
    {
      "key": "maxSteps",
      "type": "number",
      "title": "Max Steps",
      "description": "Maximum number of requests to the model one task may make before it is stopped",
      "default": 25,
      "min": 1,
      "max": 1000,
      "step": 1
    }
  ]
}
