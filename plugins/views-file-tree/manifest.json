{
  "id": "md.numen.views.file.tree",
  "name": "File Tree Explorer",
  "version": "2026.11.4",
  "protocol": 1,
  "description": "Sidebar file browser for managing notes, books, and recordings",
  "capabilities": [],
  "targets": ["desktop.editor"],
  "contributes": {
    "tabKinds": [
      {
        "kind": "files",
        "title": "Files",
        "icon": "folder-tree"
      }
    ],
    "feature": "file tree",
    "category": "views",
    "commands": [
      {
        "id": "tree.open",
        "title": "Open file tree",
        "icon": "folder-tree",
        "shortcut": "mod+shift+e"
      },
      {
        "id": "tree.revealNote",
        "title": "Show note in file tree",
        "icon": "folder-open",
        "scope": "note"
      },
      {
        "id": "tree.rename",
        "title": "Rename",
        "icon": "pencil"
      },
      {
        "id": "tree.newNote",
        "title": "New note",
        "icon": "file-plus"
      },
      {
        "id": "tree.newFolder",
        "title": "New folder",
        "icon": "folder-plus"
      }
    ],
    "menus": [
      { "location": "titleBar.commands", "command": "tree.open", "group": "navigate", "order": 10 }
    ],
    "slots": [
      { "slot": "fileTree.context", "submenu": "fileTree.new", "title": "New", "group": "1-new" },
      { "slot": "fileTree.new", "command": "tree.newNote", "group": "0-tree", "order": 10 },
      { "slot": "fileTree.new", "command": "tree.newFolder", "group": "0-tree", "order": 20 },
      { "slot": "fileTree.context", "command": "tree.rename", "group": "2-edit", "order": 10 }
    ]
  },
  "permissions": ["vault:read", "vault:write"],
  "frontend": {}
}
