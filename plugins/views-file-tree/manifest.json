{
  "id": "md.numen.views.file.tree",
  "name": "File Tree Explorer",
  "version": "2026.11.12",
  "protocol": 1,
  "description": "Sidebar file browser for managing notes, books, and recordings",
  "capabilities": [],
  "targets": ["desktop.editor"],
  "contributes": {
    "tabKinds": [
      {
        "kind": "files",
        "title": "Files",
        "icon": "folder-tree"
      }
    ],
    "feature": "file tree",
    "category": "views",
    "commands": [
      {
        "id": "tree.open",
        "title": "Open file tree",
        "icon": "folder-tree",
        "shortcut": "mod+shift+e",
        "when": "window.isVaultOpen"
      },
      {
        "id": "tree.revealNote",
        "title": "Show note in file tree",
        "icon": "folder-open",
        "when": "target.isNote"
      },
      {
        "id": "tree.renameFile",
        "title": "Rename",
        "icon": "pencil"
      },
      {
        "id": "tree.createFolder",
        "title": "Create folder",
        "icon": "folder-plus"
      }
    ],
    "slots": [
      { "slot": "titleBar.commands", "command": "tree.open", "group": "navigate", "order": 10 },
      {
        "slot": "fileTree.context",
        "submenu": "fileTree.new",
        "title": "New",
        "icon": "plus",
        "group": "1-new",
        "when": "target.isFolder"
      },
      {
        "slot": "fileTree.new",
        "command": "app:note.create",
        "group": "0-tree",
        "order": 10,
        "when": "target.isFolder"
      },
      {
        "slot": "fileTree.new",
        "command": "tree.createFolder",
        "group": "0-tree",
        "order": 20,
        "when": "target.isFolder"
      },
      {
        "slot": "fileTree.context",
        "command": "tree.renameFile",
        "group": "2-edit",
        "order": 10,
        "when": "!target.isRoot && !target.isMultiple"
      },
      { "slot": "plexGraph.context", "command": "tree.revealNote", "group": "1-note", "order": 30 }
    ]
  },
  "permissions": ["vault:read", "vault:write"],
  "frontend": {}
}
