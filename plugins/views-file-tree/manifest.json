{
  "id": "md.numen.views.file.tree",
  "name": "File Tree Explorer",
  "version": "2026.11.4",
  "protocol": 1,
  "description": "Sidebar file browser for managing notes, books, and recordings",
  "capabilities": [],
  "targets": ["desktop.editor"],
  "contributes": {
    "tabKinds": [
      {
        "kind": "files",
        "title": "Files",
        "icon": "folder-tree"
      }
    ],
    "feature": "file tree",
    "category": "views",
    "commands": [
      {
        "id": "tree.open",
        "title": "Open file tree",
        "icon": "folder-tree",
        "shortcut": "mod+shift+e"
      },
      {
        "id": "tree.revealNote",
        "title": "Show note in file tree",
        "icon": "folder-open",
        "scope": "note"
      }
    ],
    "menus": [{ "location": "titleBar.commands", "command": "tree.open", "group": "navigate", "order": 10 }]
  },
  "permissions": ["vault:read", "vault:write"],
  "frontend": {}
}
