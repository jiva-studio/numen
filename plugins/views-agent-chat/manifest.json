{
  "id": "md.numen.views.agent.chat",
  "name": "Agent Chat",
  "version": "2026.11.14",
  "protocol": 1,
  "description": "Interactive chat tab for working with AI assistants",
  "capabilities": [],
  "targets": ["desktop.editor", "desktop.flashcards"],
  "contributes": {
    "tabKinds": [
      {
        "kind": "agent",
        "title": "Agent",
        "icon": "bot"
      }
    ],
    "feature": "agent chat",
    "category": "views",
    "commands": [
      {
        "id": "chat.open",
        "title": "Open agent chat",
        "icon": "message-square",
        "when": "window.isVaultOpen"
      },
      {
        "id": "note.ask",
        "title": "Ask agent about note",
        "icon": "bot",
        "when": "target.isNote"
      }
    ],
    "slots": [
      { "slot": "titleBar.commands", "command": "chat.open", "group": "navigate", "order": 30 },
      { "slot": "fileTree.context", "command": "note.ask", "group": "5-agent", "order": 10 },
      { "slot": "plexGraph.context", "command": "note.ask", "group": "1-note", "order": 20 }
    ],
    "keybindings": [{ "key": "mod+shift+a", "command": "chat.open" }],
    "viewCapabilities": ["conversation"]
  },
  "permissions": ["vault:read", "vault:write"],
  "settings": [
    {
      "key": "connections",
      "type": "connections",
      "title": "Agents",
      "operations": ["acp.task"],
      "max": 5,
      "discover": true
    }
  ],
  "frontend": {}
}
