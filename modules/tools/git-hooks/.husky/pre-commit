#!/usr/bin/env bash
set -e

# Fast architectural gate and staged module checks before a commit is created.
# Set NUMEN_SKIP_CHECKS=1 to commit without them.
[ -n "$NUMEN_SKIP_CHECKS" ] && exit 0

root=$(git rev-parse --show-toplevel)

# 1. Staged files check
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# 2. Formatting validation (gofmt for staged Go files)
GO_FILES=$(echo "$STAGED_FILES" | grep '\.go$' || true)
if [ -n "$GO_FILES" ]; then
  UNFORMATTED=$(gofmt -l $GO_FILES || true)
  if [ -n "$UNFORMATTED" ]; then
    echo "❌ Error: The following staged Go files are not formatted with gofmt:"
    echo "$UNFORMATTED"
    echo "Please format them with 'gofmt -w <file>' and stage again."
    exit 1
  fi
fi

# 3. Fast architecture & boundary gates
node "$root/modules/tools/depgraph/check.mjs" || exit 1
"$root/modules/libs/core/adapter/index/migration-forward-only.sh" --self-test || exit 1
npm run format:check --prefix "$root/modules" || exit 1

# 4. Dynamic module discovery & targeted Make checks
has_target() {
  make -q "$1" >/dev/null 2>&1
  [ $? -ne 2 ]
}

MODULES_TO_CHECK=()
for file in $STAGED_FILES; do
  if [[ "$file" =~ ^modules/(libs|apps|tools)/([^/]+) ]]; then
    cat="${BASH_REMATCH[1]%s}" # libs -> lib, apps -> app, tools -> tool
    name="${BASH_REMATCH[2]}"
    prefix="${cat}_${name}"
    if [[ ! " ${MODULES_TO_CHECK[*]} " =~ " ${prefix} " ]]; then
      MODULES_TO_CHECK+=("$prefix")
    fi
  fi
done

for prefix in "${MODULES_TO_CHECK[@]}"; do
  TARGETS=()
  for action in check lint test; do
    if has_target "${prefix}_${action}"; then
      TARGETS+=("${prefix}_${action}")
      if [ "$action" = "check" ]; then
        break
      fi
    fi
  done

  if [ ${#TARGETS[@]} -eq 0 ] && has_target "${prefix}_build"; then
    TARGETS+=("${prefix}_build")
  fi

  if [ ${#TARGETS[@]} -gt 0 ]; then
    echo "🔍 [pre-commit] Running ${TARGETS[*]}..."
    make "${TARGETS[@]}"
  fi
done
