{
  "name": "@numen/desktop-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The desktop window: translates a vault into what the plex draws.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "typecheck": "vue-tsc --build --force",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6007 --no-open",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:stories": "vitest run --project stories"
  },
  "dependencies": {
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2",
    "@lucide/vue": "^1.34.0",
    "@numen/protocol": "file:../../../libs/protocol",
    "@numen/ui": "file:../../../libs/ui",
    "@numen/wire": "file:../../../libs/wire",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-vitest": "^10.0.0",
    "@storybook/vue3-vite": "^10.5.10",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/browser": "^3.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^27.0.0",
    "playwright": "^1.56.0",
    "storybook": "^10.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  }
}
