    "@connectrpc/connect-web": "^2.1.2",
    "@ionic/vue": "^8.5.0",
    "@numen/protocol": "*",
    "@numen/ui": "*",
    "@numen/wire": "*",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.10.0",
