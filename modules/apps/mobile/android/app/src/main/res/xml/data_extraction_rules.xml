<?xml version="1.0" encoding="utf-8"?>
<!--
  What this application keeps under its own files directory is the vault, the
  index built from it, and the settings file, which holds the keys a person
  types for a model. The core refuses to serve that file over its socket, so it
  is not handed to a backup either.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
