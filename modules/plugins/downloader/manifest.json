{
  "id": "md.numen.downloader",
  "name": "Media Downloader",
  "version": "1.0.0",
  "description": "Media and web page downloader with transcript extraction via yt-dlp",
  "capabilities": ["media.download", "downloader"],
  "targets": ["desktop.editor"],
  "activationEvents": ["onCommand:downloadMedia"],
  "permissions": ["network:outbound", "vault:write"],
  "lifecycle": {
    "mode": "on-demand",
    "idleTimeoutSeconds": 180,
    "keepAliveWhileVisible": false
  },
  "backend": {
    "type": "process",
    "entrypoint": "bin/downloader",
    "serviceName": "numen.v1.DownloadService"
  }
}
