{
  "id": "md.numen.engines.ocr",
  "name": "Document OCR",
  "version": "1.0.0",
  "protocol": 1,
  "description": "Optical character recognition using PaddleOCR and ONNX Runtime",
  "capabilities": ["recognition"],
  "targets": ["desktop.editor"],
  "activationEvents": ["onFile:*.pdf", "onCommand:ocr.recognize"],
  "permissions": ["vault:read", "network:outbound"],
  "dependencies": [{ "id": "onnxruntime", "kind": "runtime" }],
  "lifecycle": {
    "idleTimeoutSeconds": 180,
    "keepAliveWhileVisible": false,
    "memoryLimitBytes": 2147483648
  },
  "backend": {
    "type": "process",
    "entrypoint": "bin/engines.ocr",
    "serviceName": "numen.v1.RecognitionService"
  },
  "settings": [
    {
      "key": "dpi",
      "type": "range",
      "title": "Scan DPI",
      "description": "Image rendering DPI before OCR extraction",
      "default": 300,
      "min": 150,
      "max": 600,
      "step": 50
    },
    {
      "key": "language",
      "type": "enum",
      "title": "Language",
      "description": "Primary recognition language model",
      "options": ["auto", "cyrillic", "latin", "ch"],
      "default": "auto"
    },
    {
      "key": "model_profile",
      "type": "enum",
      "title": "Model Profile",
      "description": "Mobile (fast, low memory) or Server (higher accuracy)",
      "options": ["mobile", "server"],
      "default": "mobile"
    },
    {
      "key": "custom_model_path",
      "type": "string",
      "title": "Custom Model Path",
      "description": "Path to custom ONNX recognition model file",
      "default": ""
    },
    {
      "key": "custom_dict_path",
      "type": "string",
      "title": "Custom Dictionary Path",
      "description": "Path to custom character dictionary file",
      "default": ""
    }
  ]
}
