{
  "id": "md.numen.proofreading",
  "name": "LLM Proofreading",
  "version": "1.0.0",
  "protocol": 1,
  "description": "Proofreading and correction engine using large language models",
  "capabilities": ["proofreading"],
  "targets": ["desktop.editor"],
  "activationEvents": ["onCommand:proofread"],
  "permissions": ["ai:complete"],
  "settings": [
    {
      "key": "agent",
      "type": "agent",
      "title": "Agent",
      "description": "The agent and the model that proofread a text"
    }
  ],
  "lifecycle": {
    "idleTimeoutSeconds": 180,
    "keepAliveWhileVisible": false,
    "memoryLimitBytes": 1073741824
  },
  "backend": {
    "type": "process",
    "entrypoint": "bin/proofreading",
    "serviceName": "numen.v1.ProofreadingService"
  }
}
