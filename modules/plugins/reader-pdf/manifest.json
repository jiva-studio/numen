{
  "id": "md.numen.pdf",
  "name": "PDF Reader",
  "version": "1.0.0",
  "protocol": 1,
  "description": "Standalone PDF document viewer and page renderer powered by PDFium",
  "capabilities": ["document"],
  "targets": ["desktop.editor"],
  "fileExtensions": [".pdf"],
  "activationEvents": ["onFile:*.pdf"],
  "permissions": ["vault:read"],
  "lifecycle": {
    "idleTimeoutSeconds": 180,
    "keepAliveWhileVisible": false,
    "memoryLimitBytes": 2147483648
  },
  "backend": {
    "type": "process",
    "entrypoint": "bin/reader-pdf",
    "serviceName": "numen.v1.DocumentService"
  },
  "frontend": {
    "entrypoint": "dist/index.js",
    "styles": "dist/styles.css"
  }
}
