%PDF-1.4
% A document whose front matter is numbered apart from its body, which is what
% a printed book does and what a page's index does not say.
1 0 obj << /Type /Catalog /Pages 2 0 R /PageLabels << /Nums [0 << /S /r >> 2 << /S /D /St 1 >>] >> >> endobj
2 0 obj << /Type /Pages /Kids [3 0 R 5 0 R 7 0 R] /Count 3 >> endobj
3 0 obj << /Type /Page /Parent 2 0 R /MediaBox [0 0 200 200] /Contents 4 0 R /Resources << /Font << /F1 30 0 R >> >> >> endobj
4 0 obj << /Length 36 >>
stream
BT /F1 12 Tf 20 150 Td (Preface) Tj ET
endstream
endobj
5 0 obj << /Type /Page /Parent 2 0 R /MediaBox [0 0 200 200] /Contents 6 0 R /Resources << /Font << /F1 30 0 R >> >> >> endobj
6 0 obj << /Length 38 >>
stream
BT /F1 12 Tf 20 150 Td (Contents) Tj ET
endstream
endobj
7 0 obj << /Type /Page /Parent 2 0 R /MediaBox [0 0 200 200] /Contents 8 0 R /Resources << /Font << /F1 30 0 R >> >> >> endobj
8 0 obj << /Length 44 >>
stream
BT /F1 12 Tf 20 150 Td (The body begins) Tj ET
endstream
endobj
30 0 obj << /Type /Font /Subtype /Type1 /BaseFont /Helvetica >> endobj
trailer << /Root 1 0 R /Size 31 >>
%%EOF
