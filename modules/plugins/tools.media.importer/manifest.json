{
  "id": "md.numen.tools.media.importer",
  "name": "Media Importer",
  "version": "1.0.0",
  "protocol": 1,
  "description": "Media and web page downloader with transcript extraction via yt-dlp",
  "capabilities": ["downloader"],
  "targets": ["desktop.editor"],
  "activationEvents": ["onCommand:downloadMedia", "onCommand:downloader.open"],
  "permissions": ["network:outbound", "vault:write"],
  "lifecycle": {
    "idleTimeoutSeconds": 180,
    "keepAliveWhileVisible": false,
    "memoryLimitBytes": 2147483648
  },
  "backend": {
    "type": "process",
    "entrypoint": "bin/tools.media.importer",
    "serviceName": "numen.v1.DownloadService"
  },
  "frontend": {
    "entrypoint": "dist/index.js",
    "styles": "dist/styles.css"
  },
  "settings": [
    {
      "key": "yt_dlp",
      "type": "string",
      "title": "yt-dlp",
      "description": "The path to the yt-dlp program",
      "default": "",
      "replaces": ["importing.yt_dlp"]
    },
    {
      "key": "ffmpeg",
      "type": "string",
      "title": "ffmpeg",
      "description": "The path to the ffmpeg program",
      "default": "",
      "replaces": ["importing.ffmpeg"]
    }
  ]
}
