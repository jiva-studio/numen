{
  "id": "md.numen.agents.claude",
  "name": "Claude Code Agent",
  "version": "1.0.0",
  "protocol": 1,
  "description": "Claude Code CLI agent runner and provider service",
  "capabilities": [
    "agent",
    "ai.agent.provider"
  ],
  "targets": [
    "desktop.editor"
  ],
  "activationEvents": [
    "onCommand:askClaude"
  ],
  "permissions": [
    "network:outbound",
    "vault:read",
    "vault:write"
  ],
  "lifecycle": {
    "idleTimeoutSeconds": 180,
    "keepAliveWhileVisible": false,
    "memoryLimitBytes": 4294967296
  },
  "backend": {
    "type": "process",
    "entrypoint": "bin/agents.claude",
    "serviceName": "numen.v1.AgentService"
  }
}
