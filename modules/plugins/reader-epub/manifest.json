{
  "id": "md.numen.epub",
  "name": "EPUB Book Reader",
  "version": "1.0.0",
  "protocol": 1,
  "description": "EPUB reflowable book reader and metadata parser",
  "capabilities": ["book"],
  "targets": ["desktop.editor"],
  "fileExtensions": [".epub"],
  "activationEvents": ["onFile:*.epub"],
  "permissions": ["vault:read"],
  "lifecycle": {
    "idleTimeoutSeconds": 300,
    "keepAliveWhileVisible": true,
    "memoryLimitBytes": 2147483648
  },
  "backend": {
    "type": "process",
    "entrypoint": "bin/reader-epub",
    "serviceName": "numen.v1.BookService"
  },
  "frontend": {
    "entrypoint": "dist/index.js",
    "styles": "dist/styles.css"
  }
}
