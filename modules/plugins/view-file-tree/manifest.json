{
  "id": "md.numen.view-file-tree",
  "name": "File Tree Explorer",
  "version": "1.0.0",
  "protocol": 1,
  "description": "Modular file tree explorer and vault navigator",
  "capabilities": ["view.file-tree", "ui.view"],
  "targets": ["desktop.editor"],
  "activationEvents": ["onStartupFinished", "onView:file-tree"],
  "permissions": ["vault:read"],
  "frontend": {
    "entrypoint": "dist/index.js",
    "styles": "dist/styles.css"
  }
}
