{
  "name": "numen",
  "version": "0.0.0",
  "private": true,
  "description": "The source root of the interface modules. Holds no code and declares no dependencies of its own; every package below is installed from here so that one copy of a package answers for all of them.",
  "workspaces": [
    "libs/*",
    "apps/*",
    "apps/desktop/*",
    "tools/*"
  ],
  "scripts": {
    "format": "prettier --write \"{libs,apps}/**/*.{ts,vue,json,css}\"",
    "format:check": "prettier --check \"{libs,apps}/**/*.{ts,vue,json,css}\""
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "handlebars": "^4.7.10",
    "xcode": {
      "uuid": "^11.1.1"
    },
    "typed-rest-client": {
      "qs": "^6.16.0"
    },
    "postcss-selector-parser": "^7.1.6",
    "postcss-nested": {
      "postcss-selector-parser": "^7.1.6"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^7.1.6"
    }
  },
  "dependencies": {
    "typescript": "^7.0.2",
    "vue-router": "^5.4.0"
  }
}
