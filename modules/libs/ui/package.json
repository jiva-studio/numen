{
  "name": "@numen/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared interface components. Knows nothing about notes, vaults or links.",
  "files": [
    "dist"
  ],
  "main": "./dist/numen-ui.umd.cjs",
  "module": "./dist/numen-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/numen-ui.js",
      "require": "./dist/numen-ui.umd.cjs"
    },
    "./styles.css": "./dist/numen-ui.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "vue-tsc --build && vite build",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:stories": "vitest run --project stories",
    "test:watch": "vitest --project unit",
    "typecheck": "vue-tsc --build --force"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/addon-vitest": "^10.0.0",
    "@storybook/vue3-vite": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/browser": "^3.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.0.0",
    "playwright": "^1.56.0",
    "storybook": "^10.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "markdown-it": "^15.0.0",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0"
  }
}
