root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# two trailing spaces are a line break in markdown
trim_trailing_whitespace = false

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.{py,rs,kt,swift,java}]
indent_size = 4
