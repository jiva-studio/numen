{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/index.ts!", "src/**/*.stories.ts", "src/**/*.test.ts", ".storybook/**/*.{ts,js}"],
  "project": ["src/**/*.{ts,vue}", ".storybook/**/*.{ts,js}"],
  "ignoreDependencies": ["tailwindcss", "@tailwindcss/typography"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "exports": "warn",
    "types": "warn"
  }
}
