{
  "name": "@numen/shell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The chrome of the desktop windows, and the build settings they share.",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/numen-shell.css",
    "./vite": "./src/vite.ts"
  },
  "scripts": {
    "storybook": "storybook dev -p 6008 --no-open",
    "build": "vue-tsc --build && vite build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:stories": "vitest run --project stories",
    "typecheck": "vue-tsc --build --force",
    "lint": "eslint .",
    "knip": "knip"
  },
  "peerDependencies": {
    "vue": "^3.5.44"
  },
  "dependencies": {
    "@numen/ui": "*",
    "reka-ui": "^2.10.3"
  },
  "devDependencies": {
    "@lucide/vue": "^1.57.0",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/vue3-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "jsdom": "^30.1.3",
    "knip": "^6.41.0",
    "lightningcss": "^1.33.0",
    "playwright": "^1.64.1",
    "storybook": "^10.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
