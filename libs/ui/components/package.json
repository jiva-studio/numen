{
  "name": "@numen/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared interface components and design tokens for desktop and mobile clients.",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/numen-ui.css",
    "./theme.css": "./src/shared/tokens/theme.css",
    "./vite": "./src/vite.ts"
  },
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "vue-tsc --build && vite build",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "test": "npm run test:unit && npm run test:stories",
    "test:unit": "vitest run --project unit",
    "test:stories": "node ../../../tools/ci-stories/run.mjs libs/ui/components libs/ui/components/src",
    "test:watch": "vitest --project unit",
    "typecheck": "vue-tsc --build",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ ."
  },
  "peerDependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/vue3-vite": "^10.6.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.2",
    "eslint-plugin-storybook": "^10.6.6",
    "jsdom": "^31.0.0",
    "lightningcss": "^1.33.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "storybook": "^10.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@lucide/vue": "^1.70.0",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "markdown-it": "^15.0.3",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0"
  }
}
