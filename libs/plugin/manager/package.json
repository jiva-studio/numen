{
  "name": "@numen/plugin-manager",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The plugin list and the plugin page: what is installed, what the catalog offers, and the controls to enable, install and inspect a plugin. Takes data by props and answers with events.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ ."
  },
  "peerDependencies": {
    "vue": "^3.5.45"
  },
  "dependencies": {
    "@numen/ui": "*",
    "@lucide/vue": "^1.70.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "jsdom": "^31.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.0.3",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
