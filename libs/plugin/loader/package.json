{
  "name": "@numen/plugin-loader",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The loader of plugin frontends in an application: manifest, bundle, stylesheet, activation with a context the application makes, deactivation by setting; and the build of the host modules the application serves to plugin bundles.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/vite.ts"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ ."
  },
  "dependencies": {
    "@bufbuild/cel": "0.6.2",
    "@numen/core-client": "*",
    "@numen/plugin-sdk": "*",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.0.3"
  }
}
