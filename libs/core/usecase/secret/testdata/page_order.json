[
  {
    "name": "asked groups come first, each by name, then the groups of the person",
    "asked": ["openai", "anthropic"],
    "secrets": [
      { "id": "s1", "group": "mine" },
      { "id": "s2", "group": "openai" },
      { "id": "s3", "group": "anthropic" },
      { "id": "s4", "group": "alpha" }
    ],
    "expected": ["s3", "s2", "s4", "s1"]
  },
  {
    "name": "inside a group the order of the list is kept",
    "asked": ["openai"],
    "secrets": [
      { "id": "s1", "group": "openai" },
      { "id": "s2", "group": "other" },
      { "id": "s3", "group": "openai" }
    ],
    "expected": ["s1", "s3", "s2"]
  },
  {
    "name": "names are compared by their UTF-8 bytes, not by UTF-16 units",
    "asked": [],
    "secrets": [
      { "id": "s1", "group": "𝒜" },
      { "id": "s2", "group": "ｱ" },
      { "id": "s3", "group": "Z" },
      { "id": "s4", "group": "a" }
    ],
    "expected": ["s3", "s4", "s2", "s1"]
  }
]
