#!/usr/bin/env bash
set -e

# Cheap formatting gate before a commit is created. The architecture and quality checks run in CI.
# Set NUMEN_SKIP_CHECKS=1 to commit without it.
[ -n "$NUMEN_SKIP_CHECKS" ] && exit 0

GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
if [ -n "$GO_FILES" ]; then
  UNFORMATTED=$(gofmt -l $GO_FILES || true)
  if [ -n "$UNFORMATTED" ]; then
    echo "❌ Error: The following staged Go files are not formatted with gofmt:"
    echo "$UNFORMATTED"
    echo "Please format them with 'gofmt -w <file>' and stage again."
    exit 1
  fi
fi
