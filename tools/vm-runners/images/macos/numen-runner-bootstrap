#!/bin/bash
set -uo pipefail

shared="/Volumes/My Shared Files/garm"
export PATH="$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"

for _ in $(seq 1 180); do
  [ -f "$shared/bootstrap.sh" ] && break
  sleep 1
done
if [ ! -f "$shared/bootstrap.sh" ]; then
  echo "numen-runner-bootstrap: $shared/bootstrap.sh does not exist" >&2
  exit 0
fi
if [ -e "$shared/bootstrap.started" ]; then
  exit 0
fi
: >"$shared/bootstrap.started"
cd "$HOME" || exit 1
/bin/bash "$shared/bootstrap.sh" >>"$shared/bootstrap.log" 2>&1
echo "$?" >"$shared/bootstrap.exit"
