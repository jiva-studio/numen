{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "exports": "warn",
    "types": "warn"
  },
  "ignoreWorkspaces": [
    ".",
    "libs/protocol",
    "tools/*"
  ],
  "workspaces": {
    "libs/ui/core": {
      "entry": [
        "src/index.ts!",
        "src/**/*.stories.ts",
        "src/**/*.test.ts",
        ".storybook/**/*.{ts,js}"
      ],
      "project": [
        "src/**/*.{ts,vue,mdx,css}",
        ".storybook/**/*.{ts,js}"
      ]
    },
    "libs/ui/shell": {
      "entry": [
        "src/index.ts!",
        "src/**/*.stories.ts",
        "src/**/*.test.ts",
        ".storybook/**/*.{ts,js}"
      ],
      "project": [
        "src/**/*.{ts,vue,mdx,css}",
        ".storybook/**/*.{ts,js}"
      ]
    },
    "libs/core-client": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "libs/plugin-host-ts": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "libs/plugin-manager": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,vue}"
      ]
    },
    "libs/plugin-sdk-ts": {
      "entry": [
        "src/**/*.test.ts",
        "test/**/*.test.ts",
        "stories/vitest.config.ts",
        "stories/.storybook/**/*.{ts,js}"
      ],
      "project": [
        "src/**/*.{ts,vue}",
        "test/**/*.ts",
        "stories/**/*.{ts,js}"
      ]
    },
    "apps/desktop/editor": {
      "entry": [
        "src/**/*.stories.ts",
        "src/**/*.test.ts",
        ".storybook/**/*.{ts,js}"
      ],
      "project": [
        "src/**/*.{ts,vue}",
        ".storybook/**/*.{ts,js}"
      ]
    },
    "apps/desktop/flashcards": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,vue}"
      ]
    },
    "apps/mobile": {
      "entry": [
        "src/main.ts",
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,vue}"
      ],
      "ignoreDependencies": [
        "vue-router"
      ]
    },
    "apps/docs": {
      "entry": [
        "tools/*.mjs"
      ],
      "project": [
        "src/**/*.{ts,astro,vue}",
        "tools/**/*.mjs"
      ],
      "ignoreDependencies": [
        "@fontsource-variable/newsreader",
        "@fontsource/ibm-plex-mono",
        "@fontsource/ibm-plex-sans"
      ]
    },
    "apps/landing": {
      "entry": [
        "tools/*.mjs"
      ],
      "project": [
        "src/**/*.{ts,astro,vue}",
        "tools/**/*.mjs"
      ],
      "ignoreDependencies": [
        "@fontsource-variable/newsreader",
        "@fontsource/ibm-plex-mono",
        "@fontsource/ibm-plex-sans",
        "@vitejs/plugin-vue",
        "@lucide/vue",
        "vue",
        "@numen/core-client",
        "@numen/plugin-host",
        "@numen/ui-shell",
        "@plugins/views-file-tree",
        "@plugins/views-plex-graph",
        "@plugins/notes",
        "@plugins/readers-pdf",
        "@plugins/views-media-player",
        "@plugins/views-flashcards-studio",
        "@plugins/views-agent-chat",
        "@editor-features/tab-linking"
      ]
    },
    "tests/e2e/desktop": {
      "entry": [
        "playwright.config.ts",
        "playwright.flashcards.config.ts",
        "eslint.config.js",
        "scripts/*.mjs",
        "tools/epub-frames/*.mjs",
        "flashcards/**/*.spec.ts",
        "tests/**/*.spec.ts"
      ],
      "project": [
        "**/*.{ts,mjs,js}"
      ],
      "ignoreBinaries": [
        "nix",
        "ffmpeg",
        "ffprobe",
        "unshare"
      ]
    },
    "plugins/*": {
      "entry": [
        "frontend/index.ts",
        "frontend/**/*.stories.ts",
        "frontend/**/*.test.ts"
      ],
      "project": [
        "frontend/**/*.{ts,vue}"
      ]
    }
  }
}
