{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "exports": "error",
    "types": "error"
  },
  "ignoreWorkspaces": [
    ".",
    "tools/*"
  ],
  "workspaces": {
    "libs/ui/components": {
      "entry": [
        "src/index.ts!",
        "src/**/*.stories.ts",
        ".storybook/**/*.{ts,js}"
      ],
      "project": [
        "src/**/*.{ts,vue,mdx,css}",
        ".storybook/**/*.{ts,js}",
        "!**/*.test.ts"
      ],
      "vitest": false
    },
    "libs/ui/workbench": {
      "entry": [
        "src/index.ts!",
        "src/**/*.stories.ts",
        ".storybook/**/*.{ts,js}"
      ],
      "project": [
        "src/**/*.{ts,vue,mdx,css}",
        ".storybook/**/*.{ts,js}",
        "!**/*.test.ts"
      ],
      "vitest": false
    },
    "libs/core/protocol": {
      "entry": [
        "index.ts",
        "capabilities.ts",
        "src/numen/v1/*_pb.ts",
        "tools/*.mjs"
      ],
      "project": [
        "**/*.{ts,mjs}"
      ],
      "ignoreBinaries": [
        "buf"
      ],
      "ignoreDependencies": [
        "@bufbuild/protoc-gen-es"
      ]
    },
    "libs/core/client": {
      "project": [
        "src/**/*.ts",
        "!**/*.test.ts"
      ],
      "vitest": false
    },
    "libs/plugin/loader": {
      "project": [
        "src/**/*.ts",
        "!**/*.test.ts"
      ],
      "vitest": false
    },
    "libs/plugin/manager": {
      "project": [
        "src/**/*.{ts,vue}",
        "!**/*.test.ts"
      ],
      "vitest": false
    },
    "libs/plugin/sdk-ts": {
      "entry": [
        "stories/vitest.config.ts",
        "stories/.storybook/**/*.{ts,js}"
      ],
      "project": [
        "src/**/*.{ts,vue}",
        "test/**/*.ts",
        "stories/**/*.{ts,js}",
        "!**/*.test.ts"
      ],
      "vitest": false
    },
    "apps/desktop/editor": {
      "entry": [
        "src/**/*.stories.ts",
        ".storybook/**/*.{ts,js}"
      ],
      "project": [
        "src/**/*.{ts,vue}",
        ".storybook/**/*.{ts,js}",
        "!**/*.test.ts"
      ],
      "vitest": false
    },
    "apps/desktop/flashcards": {
      "project": [
        "src/**/*.{ts,vue}",
        "!**/*.test.ts"
      ],
      "vitest": false
    },
    "apps/mobile": {
      "entry": [
        "src/main.ts"
      ],
      "project": [
        "src/**/*.{ts,vue}",
        "!**/*.test.ts"
      ],
      "ignoreDependencies": [
        "vue-router"
      ],
      "vitest": false
    },
    "apps/docs": {
      "entry": [
        "tools/*.mjs"
      ],
      "project": [
        "src/**/*.{ts,astro,vue}",
        "tools/**/*.mjs"
      ],
      "ignoreDependencies": [
        "@fontsource-variable/newsreader",
        "@fontsource/ibm-plex-mono",
        "@fontsource/ibm-plex-sans"
      ]
    },
    "apps/landing": {
      "entry": [
        "tools/*.mjs"
      ],
      "project": [
        "src/**/*.{ts,astro,vue}",
        "tools/**/*.mjs"
      ],
      "paths": {
        "@editor-features/*": [
          "../desktop/editor/src/features/*"
        ],
        "@plugins/*": [
          "../../plugins/*"
        ],
        "@numen/workbench": [
          "../../libs/ui/workbench/src/index.ts"
        ],
        "@numen/workbench/styles.css": [
          "../../libs/ui/workbench/src/styles.css"
        ]
      }
    },
    "tests/e2e/desktop": {
      "entry": [
        "playwright.config.ts",
        "playwright.flashcards.config.ts",
        "eslint.config.js",
        "scripts/*.mjs",
        "flashcards/**/*.spec.ts",
        "tests/**/*.spec.ts"
      ],
      "project": [
        "**/*.{ts,mjs,js}"
      ],
      "ignoreBinaries": [
        "nix",
        "ffmpeg",
        "ffprobe",
        "unshare"
      ]
    },
    "plugins/*": {
      "entry": [
        "frontend/index.ts",
        "frontend/**/*.stories.ts"
      ],
      "project": [
        "frontend/**/*.{ts,vue}",
        "!**/*.test.ts"
      ],
      "vitest": false
    }
  }
}
