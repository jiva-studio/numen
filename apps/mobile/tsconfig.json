{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "types": ["node", "vite/client"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@numen/plugin-sdk": ["../../libs/plugin-sdk-ts/src/index.ts"],
      "@numen/plugin-sdk/*": ["../../libs/plugin-sdk-ts/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "*.config.ts"]
}
