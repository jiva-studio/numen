{
  "name": "@numen/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile application shell for iOS and Android.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --build",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ ."
  },
  "//": "vue-router is named in no source file here and is required all the same: @ionic/vue imports routeLocationKey, useRoute and matchedRouteKey from it at the top of its entry, and declares no peer dependency on it.",
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.5.2",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-web": "^2.3.0",
    "@ionic/vue": "^9.0.10",
    "@numen/core-client": "*",
    "@numen/ui": "*",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.1",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.14"
  }
}
