{
  "name": "@numen/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The manual, for the person using the application. Knows nothing about a vault.",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run manual && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "manual": "node tools/manual.mjs",
    "manual:check": "node tools/manual.mjs --check",
    "test": "node --test tools/reference.test.mjs tools/cell.test.mjs",
    "shoot": "node tools/shoot.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.8",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "astro": "^7.4.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.14.0",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
