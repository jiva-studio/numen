<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>md.numen.Numen</id>
  <name>Numen</name>
  <summary>Notes linked into a graph, with the sources under them</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>

  <developer id="md.numen">
    <name>Jiva Studio</name>
  </developer>

  <description>
    <p>
      A knowledge tool: markdown notes in a folder of your own, linked into a graph, a typed
      hierarchy with several parents, spaced repetition, and a source layer over PDF and audio.
    </p>
  </description>

  <launchable type="desktop-id">md.numen.Numen.desktop</launchable>
  <provides>
    <binary>numen</binary>
    <binary>numen-flashcards</binary>
  </provides>

  <url type="homepage">https://numen.md</url>
  <url type="help">https://docs.numen.md</url>
  <url type="contact">https://forum.numen.md</url>

  <content_rating type="oars-1.1"/>
</component>
