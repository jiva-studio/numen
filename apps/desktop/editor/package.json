{
  "name": "@numen/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The desktop window: translates a vault into what the plex draws.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "typecheck": "vue-tsc --build",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "storybook": "storybook dev -p 6007 --no-open",
    "test": "npm run test:unit && npm run test:stories",
    "test:unit": "vitest run --project unit",
    "test:stories": "node ../../../tools/ci-stories/run.mjs apps/desktop/editor apps/desktop/editor/src"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.11",
    "@lezer/markdown": "^1.7.2",
    "@lucide/vue": "^1.70.0",
    "@numen/core-client": "*",
    "@numen/plugin-loader": "*",
    "@numen/plugin-manager": "*",
    "@numen/ui": "*",
    "@numen/workbench": "*",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/vue3-vite": "^10.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.2",
    "jsdom": "^31.0.0",
    "playwright": "^1.64.1",
    "storybook": "^10.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.14"
