{
  "name": "@numen/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The desktop window: translates a vault into what the plex draws.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "typecheck": "vue-tsc --build --force",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6007 --no-open",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:stories": "vitest run --project stories"
  },
  "dependencies": {
    "@connectrpc/connect": "^2.1.2",
    "@lucide/vue": "^1.57.0",
    "@numen/plugin-host": "*",
    "@numen/plugin-sdk": "*",
    "@numen/shell": "*",
    "@numen/protocol": "*",
    "@numen/ui": "*",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/vue3-vite": "^10.6.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "storybook": "^10.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13"
  }
}
