{
  "name": "@numen/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The desktop window: translates a vault into what the plex draws.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "typecheck": "vue-tsc --build",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "storybook": "storybook dev -p 6007 --no-open",
    "test": "npm run test:unit && npm run test:stories",
    "test:unit": "vitest run --project unit",
    "test:stories": "node ../../../tools/ci-stories/run.mjs apps/desktop/editor apps/desktop/editor/src"
  },
  "dependencies": {
    "@lucide/vue": "^1.69.0",
    "@numen/core-client": "*",
    "@numen/plugin-loader": "*",
    "@numen/plugin-manager": "*",
    "@numen/workbench": "*",
    "@numen/ui": "*",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/vue3-vite": "^10.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "storybook": "^10.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.14"
  }
}
