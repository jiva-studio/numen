{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "jsx": "preserve",
    "types": ["vite/client"],

    "paths": {
      "@/*": ["./src/*"],
      "@numen/plugin-sdk": ["../../../libs/plugin-sdk-ts/src/index.ts"],
      "@numen/plugin-sdk/*": ["../../../libs/plugin-sdk-ts/src/*"],
      "@numen/protocol": ["../../../libs/protocol/index.ts"],
      "@numen/protocol/*": ["../../../libs/protocol/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts", "vitest.setup.ts"]
}
