{
  "name": "@numen/flashcards",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The desktop window a person runs their cards in: a shell over the plugins of the desktop.flashcards target.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "typecheck": "vue-tsc --build",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@numen/core-client": "*",
    "@numen/plugin-loader": "*",
    "@numen/workbench": "*",
    "@numen/ui": "*",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.14"
  }
}
