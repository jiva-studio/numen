---
import {
  type CatalogPlugin,
  formatPercent,
  formatSize,
  getPlatformName,
  getQualityKind,
} from './catalog'
import { EN } from '../../scripts/i18n-en'

interface Props {
  plugin: CatalogPlugin
}

const { plugin } = Astro.props
const added = new Set(plugin.permissionsAdded)
---

<section class="plugin-section" aria-labelledby="plugin-checks">
  <h2 id="plugin-checks" data-i18n="plugin_checks">Checks</h2>
  <p class="plugin-muted" data-i18n="plugin_checks_lede">
    The registry runs these checks on the plugin every night.
  </p>
  <ul class="plugin-checks">
    {
      plugin.checks.map((check) => (
        <li class="plugin-check" data-status={check.status}>
          <span class="plugin-check__status" data-i18n={`plugin_status_${check.status}`}>
            {EN[`plugin_status_${check.status}`] ?? check.status}
          </span>
          <strong data-i18n={`plugin_check_${check.id}`}>
            {EN[`plugin_check_${check.id}`] ?? check.id}
          </strong>
          <span class="plugin-muted">{check.detail}</span>
        </li>
      ))
    }
  </ul>
</section>

<section class="plugin-section" aria-labelledby="plugin-permissions">
  <h2 id="plugin-permissions" data-i18n="plugin_permissions">Permissions</h2>
  {
    plugin.permissions.length === 0 ? (
      <p class="plugin-muted" data-i18n="plugin_permissions_none">
        This plugin asks for no permissions.
      </p>
    ) : (
      <ul class="plugin-list">
        {plugin.permissions.map((permission) => (
          <li>
            <span>{permission.description}</span> <code>{permission.id}</code>
            {added.has(permission.id) && (
              <span class="plugin-tag" data-i18n="plugin_permission_added">
                New in this version
              </span>
            )}
          </li>
        ))}
      </ul>
    )
  }
</section>

{
  plugin.settings.length > 0 && (
    <section class="plugin-section" aria-labelledby="plugin-settings">
      <h2 id="plugin-settings" data-i18n="plugin_settings">
        Settings it adds
      </h2>
      <ul class="plugin-list">
        {plugin.settings.map((setting) => (
          <li>
            <strong>{setting.title}</strong>
            {setting.description && <span class="plugin-muted"> — {setting.description}</span>}
          </li>
        ))}
      </ul>
    </section>
  )
}

{
  plugin.commands.length > 0 && (
    <section class="plugin-section" aria-labelledby="plugin-commands">
      <h2 id="plugin-commands" data-i18n="plugin_commands">
        Commands it adds
      </h2>
      <ul class="plugin-list">
        {plugin.commands.map((command) => (
          <li>{command.title}</li>
        ))}
      </ul>
    </section>
  )
}

<section class="plugin-section" aria-labelledby="plugin-downloads">
  <h2 id="plugin-downloads" data-i18n="plugin_downloads">What it downloads</h2>
  {
    plugin.downloads.length === 0 ? (
      <p class="plugin-muted" data-i18n="plugin_downloads_none">
        It declares no downloads.
      </p>
    ) : (
      <ul class="plugin-list">
        {plugin.downloads.map((download) => (
          <li>
            <strong>{download.id}</strong> {download.version}
            <ul class="plugin-sublist">
              {download.platforms.map((file) => (
                <li>
                  {getPlatformName(file.platform)}:{' '}
                  {file.size === null ? (
                    <span data-i18n="plugin_size_unknown">size unknown</span>
                  ) : (
                    formatSize(file.size)
                  )}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    )
  }
</section>

{
  plugin.artifacts.length > 0 && (
    <section class="plugin-section" aria-labelledby="plugin-artifacts">
      <h2 id="plugin-artifacts" data-i18n="plugin_artifacts">
        Release artifacts
      </h2>
      <ul class="plugin-list">
        {plugin.artifacts.map((artifact) => (
          <li>
            <a href={artifact.url}>{artifact.name}</a> {formatSize(artifact.size)}
            {artifact.sha256 && <code class="plugin-hash">{artifact.sha256}</code>}
          </li>
        ))}
      </ul>
    </section>
  )
}

<section class="plugin-section" aria-labelledby="plugin-quality">
  <h2 id="plugin-quality" data-i18n="plugin_quality">Tests</h2>
  {
    plugin.quality === null ? (
      <p class="plugin-muted" data-i18n="plugin_quality_none">
        Not measured yet.
      </p>
    ) : (
      <>
        <dl class="plugin-quality">
          {plugin.quality.entries.map((entry) => (
            <>
              {entry.mutationScore !== null && (
                <>
                  <dt>
                    <span data-i18n="plugin_mutation">Mutation score</span> {getQualityKind(entry)}
                  </dt>
                  <dd>{formatPercent(entry.mutationScore)}</dd>
                </>
              )}
              {entry.coverage !== null && (
                <>
                  <dt>
                    <span data-i18n="plugin_coverage">Coverage</span> {getQualityKind(entry)}
                  </dt>
                  <dd>{formatPercent(entry.coverage)}</dd>
                </>
              )}
            </>
          ))}
        </dl>
        {plugin.quality.reportedBy === 'author' ? (
          <p class="plugin-muted" data-i18n="plugin_quality_author">
            Reported by the author.
          </p>
        ) : (
          <p class="plugin-muted" data-i18n="plugin_quality_numen">
            Measured every night by Numen CI.
          </p>
        )}
      </>
    )
  }
</section>
