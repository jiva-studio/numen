---
import { type CatalogPlugin, getAppNames, getCategoryName, getPluginPath, getSearchText } from './catalog'

interface Props {
  plugin: CatalogPlugin
}

const { plugin } = Astro.props
const meta = [getCategoryName(plugin.category), ...getAppNames(plugin.targets)].join(' · ')
---

<li
  class="plugin-card"
  data-plugin-card
  data-search={getSearchText(plugin)}
  data-category={plugin.category}
  data-apps={plugin.targets.join(' ')}
  data-paid={String(plugin.isPaid)}
  data-official={String(plugin.isOfficial)}
>
  <div class="plugin-card__head">
    <h2><a href={getPluginPath(plugin.id)}>{plugin.name}</a></h2>
    {plugin.isPaid && <span class="plugin-badge" data-i18n="plugins_paid">Paid</span>}
    {!plugin.isOfficial && <span class="plugin-badge" data-i18n="plugins_community">Community</span>}
  </div>
  <p class="plugin-card__text">{plugin.description}</p>
  <p class="plugin-card__meta">{meta}</p>
</li>
