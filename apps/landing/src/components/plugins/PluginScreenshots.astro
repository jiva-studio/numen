---
/** Up to three screenshots of a plugin as 16:10 thumbnails; each opens the full image. */
import { type CatalogPlugin } from './catalog'
import { listShots } from './screenshots'

interface Props {
  plugin: CatalogPlugin
}

const { plugin } = Astro.props
const shots = await listShots(plugin, 3)
const images = shots.flatMap((shot) =>
  [
    { image: shot.light, theme: shot.dark ? 'img-light' : undefined },
    { image: shot.dark, theme: shot.light ? 'img-dark' : undefined },
  ].flatMap(({ image, theme }) =>
    image ? [{ ...image, theme, alt: `${plugin.name}: ${shot.name}` }] : [],
  ),
)
---

{
  images.length > 0 && (
    <div class="plugin-shots">
      {images.map((image) => (
        <a class:list={['plugin-shot', image.theme]} href={image.src} target="_blank" rel="noopener">
          <img
            src={image.src}
            width={image.width}
            height={image.height}
            alt={image.alt}
            loading="lazy"
          />
        </a>
      ))}
    </div>
  )
}
