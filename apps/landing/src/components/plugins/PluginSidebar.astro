---
import {
  type CatalogPlugin,
  formatDate,
  getAppNames,
  getCategoryName,
  getPlatformName,
} from './catalog'

interface Props {
  plugin: CatalogPlugin
}

const { plugin } = Astro.props
---

<aside class="u-card plugin-sidebar">
  <dl>
    <dt data-i18n="plugin_version">Version</dt>
    <dd>{plugin.version}</dd>
    {
      plugin.updatedAt && (
        <>
          <dt data-i18n="plugin_updated">Last updated</dt>
          <dd>
            <time datetime={plugin.updatedAt}>{formatDate(plugin.updatedAt)}</time>
          </dd>
        </>
      )
    }
    <dt data-i18n="plugin_author">Author</dt>
    <dd>{plugin.author}</dd>
    <dt data-i18n="plugin_license">License</dt>
    <dd>{plugin.license ?? '—'}</dd>
    <dt data-i18n="plugin_platforms">Platforms</dt>
    <dd>{plugin.platforms.map(getPlatformName).join(', ')}</dd>
    <dt data-i18n="plugin_apps">Works in</dt>
    <dd>{getAppNames(plugin.targets).join(', ')}</dd>
    <dt data-i18n="plugin_category">Category</dt>
    <dd>{getCategoryName(plugin.category)}</dd>
    <dt data-i18n="plugin_price">Price</dt>
    <dd>
      {
        plugin.isPaid ? (
          <span data-i18n="plugins_paid">Paid</span>
        ) : (
          <span data-i18n="plugins_free">Free</span>
        )
      }
    </dd>
  </dl>
  <a class="button-secondary button-small" href={plugin.source.url} target="_blank" rel="noopener">
    <span data-i18n="plugin_source">Source code</span>
  </a>
</aside>
