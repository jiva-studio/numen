---
/**
 * The side column of a plugin page: contributors, the apps and platforms it works on, its source,
 * links to report a bug or ask for a feature, and plugins that go with it.
 */
import PluginIcon from './PluginIcon.astro'
import {
  type CatalogPlugin,
  getAppNames,
  getBugReportUrl,
  getFeatureRequestUrl,
  getInitial,
  getPlatformName,
  getPluginPath,
} from './catalog'

interface Props {
  plugin: CatalogPlugin
  related: CatalogPlugin[]
}

const { plugin, related } = Astro.props
const apps = getAppNames(plugin.targets).join(' · ')
const platforms = plugin.platforms.map(getPlatformName).join(' · ')
---

<aside class="plugin-side">
  {
    plugin.contributors.length > 0 && (
      <section class="plugin-side__section">
        <h2>
          <span data-i18n="plugin_contributors">Contributors</span>
          <span class="plugin-count">{plugin.contributors.length}</span>
        </h2>
        <ul class="plugin-people">
          {plugin.contributors.map((person) => (
            <li>
              <span class="plugin-avatar" aria-hidden="true">
                {getInitial(person.name)}
              </span>
              {person.name}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="plugin-side__section">
    <h2 data-i18n="plugin_compatibility">Compatibility</h2>
    {apps && <span>{apps}</span>}
    {platforms && <span>{platforms}</span>}
  </section>

  <section class="plugin-side__section">
    <h2 data-i18n="plugin_source">Source code</h2>
    <a class="plugin-side__link" href={plugin.source.url} target="_blank" rel="noopener">
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.71 1.22 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
        />
      </svg>
      <span data-i18n="plugin_view_source">View source</span>
      <span aria-hidden="true">↗</span>
    </a>
  </section>

  <div class="plugin-side__actions">
    <a
      class="button-secondary button-small"
      href={getBugReportUrl(plugin)}
      target="_blank"
      rel="noopener"
      data-i18n="plugin_report_bug">Report bug</a
    >
    <a
      class="button-secondary button-small"
      href={getFeatureRequestUrl(plugin)}
      target="_blank"
      rel="noopener"
      data-i18n="plugin_request_feature">Request feature</a
    >
  </div>

  {
    related.length > 0 && (
      <section class="plugin-side__section plugin-side__related">
        <h2 data-i18n="plugin_related">Works well with</h2>
        <ul class="plugin-related">
          {related.map((one) => (
            <li>
              <a class="plugin-entry" href={getPluginPath(one.id)}>
                <span class="plugin-tile plugin-tile--small">
                  <PluginIcon name={one.icon} />
                </span>
                <span class="plugin-entry__text">
                  <span class="plugin-entry__name">{one.name}</span>
                  <span class="plugin-entry__description">{one.description}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</aside>
