---
/**
 * The top of a product page: eyebrow, title, lede, the Download and GitHub buttons with the facts
 * of the product beside them, and the picture given in the slot under them.
 */
import LucideIcon from './LucideIcon.astro'
import { GITHUB, GITHUB_ICON } from './site'

type Text = { key?: string; text: string }

interface Props {
  eyebrow: Text
  title: { key: string; html: string }
  lede: Text
  facts: (Text & { icon: string })[]
}

const { eyebrow, title, lede, facts } = Astro.props
---

<section class="hero" id="top">
  <div class="container">
    <div class="hero-top">
      <div class="hero-copy">
        <p class="eyebrow">
          <span></span>
          <b data-i18n={eyebrow.key}>{eyebrow.text}</b>
        </p>
        <!-- avoid-ai-design-ignore: SD5 -->
        <h1 data-i18n-html={title.key} set:html={title.html} />
        <p class="hero-lede" data-i18n={lede.key}>{lede.text}</p>
        <div class="hero-actions">
          <a class="button" href="#get">
            <span data-i18n="nav_download">Download</span>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8 2.5v8.5M4.5 7.8 8 11.3l3.5-3.5M3 13.5h10"></path>
            </svg>
          </a>
          <a class="button-secondary" href={GITHUB} target="_blank" rel="noopener">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d={GITHUB_ICON}></path></svg>
            <span>GitHub</span>
          </a>
          <ul class="hero-meta">
            {
              facts.map((fact) => (
                <li>
                  <LucideIcon name={fact.icon} />
                  <span data-i18n={fact.key}>{fact.text}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <slot />
  </div>
</section>
