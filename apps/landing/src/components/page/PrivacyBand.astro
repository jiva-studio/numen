---
import LucideIcon from './LucideIcon.astro'

const ITEMS = [
  {
    icon: 'file-text',
    key: 'yours_f1',
    title: 'Open Markdown files',
    text: 'Plain .md files in your own folders. Open them in any editor, track them in Git, and keep them for decades without lock-in.',
  },
  {
    icon: 'cpu',
    key: 'yours_f2',
    title: 'Local on-device models',
    text: 'Speech transcription, PDF OCR and semantic search run on your machine. Nothing is uploaded.',
  },
  {
    icon: 'eye-off',
    key: 'yours_f3',
    title: 'Private by default',
    text: 'No sign-up and no telemetry. Point Numen at an existing folder of notes and books and work completely offline.',
  },
  {
    icon: 'code-xml',
    key: 'yours_f4',
    title: 'Open source',
    text: 'Inspect every line of code on GitHub under AGPL-3.0.',
  },
]
---

<section class="problem band">
  <div class="container">
    <div class="problem-layout">
      <div class="problem-copy">
        <p class="section-kicker" data-i18n="yours_eyebrow">Privacy-First &amp; Local-First</p>
        <h2 data-i18n="yours_title">Your thoughts are yours.</h2>
        <p data-i18n="yours_lede">
          No sign-up, no email, no telemetry, no vendor lock-in, and no proprietary database.
          Your vault is an ordinary folder of plain Markdown files on your disk — backed by
          on-device AI models that run on your own hardware.
        </p>
      </div>

      <ul class="trust-list">
        {
          ITEMS.map((item) => (
            <li>
              <LucideIcon name={item.icon} />
              <div>
                <h3 data-i18n={`${item.key}_t`}>{item.title}</h3>
                <p data-i18n={`${item.key}_p`}>{item.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
