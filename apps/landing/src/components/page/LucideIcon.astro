---
/** A lucide icon as inline SVG; its size, stroke and colour come from the surrounding styles. */
import { getIconMarkup } from '../plugins/icons'

interface Props {
  name: string
}

const { name } = Astro.props
const markup = await getIconMarkup(name)
---

<svg viewBox="0 0 24 24" aria-hidden="true" set:html={markup} />
