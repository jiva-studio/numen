---
import { DOCS, DOWNLOAD, FORUM, GITHUB, STUDIO } from './site'

const LICENSE = `${GITHUB}blob/main/LICENSE`
const ISSUES = `${GITHUB}issues`
---

<footer>
  <div class="footer-top">
    <div class="footer-brand">
      <a class="brand" href="/">
        <img class="brand-logo" src="/favicon.svg" width="28" height="28" alt="" />
        <span>numen</span>
      </a>
      <p data-i18n="hero_eyebrow">Your second brain that actually remembers</p>
    </div>

    <nav class="footer-links" aria-label="Footer">
      <div>
        <h2 data-i18n="footer_product">Product</h2>
        <a href={DOWNLOAD} data-i18n="nav_download">Download</a>
        <a href="/#sync">Numen Sync</a>
      </div>
      <div>
        <h2 data-i18n="footer_resources">Resources</h2>
        <a href={DOCS} data-i18n="nav_docs">Docs</a>
        <a href={FORUM} data-i18n="nav_forum">Forum</a>
        <a href={ISSUES} target="_blank" rel="noopener" data-i18n="footer_issues">Report an issue</a>
      </div>
      <div>
        <h2 data-i18n="footer_code">Source code</h2>
        <a href={GITHUB} target="_blank" rel="noopener">GitHub</a>
        <a href={LICENSE} target="_blank" rel="noopener">AGPL-3.0</a>
      </div>
    </nav>
  </div>

  <div class="footer-bottom">
    <span>© 2026 <a href={STUDIO} target="_blank" rel="noopener">Jiva Studio</a></span>
  </div>
</footer>
