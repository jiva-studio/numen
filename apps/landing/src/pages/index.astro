    function onToggleTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'light'
      const next = current === 'light' ? 'dark' : 'light'
      document.documentElement.setAttribute('data-theme', next)
      try {
        localStorage.setItem('numen-theme', next)
      } catch {
        // Ignore storage errors in private mode.
      }
    }

    function setLanguage(lang: string) {
      const dict = I18N[lang]
      if (!dict) return
      document.documentElement.setAttribute('lang', lang)
      const label = document.getElementById('lang-current-label')
      if (label) label.textContent = lang.toUpperCase()
      for (const item of document.querySelectorAll<HTMLElement>('.lang-dropdown__item')) {
        item.setAttribute('aria-selected', String(item.getAttribute('data-lang') === lang))
      }
      const menu = document.getElementById('lang-menu')
      const trigger = document.getElementById('lang-dropdown-btn')
      if (menu) menu.setAttribute('hidden', '')
      if (trigger) trigger.setAttribute('aria-expanded', 'false')

      for (const el of document.querySelectorAll<HTMLElement>('[data-i18n]')) {
        const key = el.getAttribute('data-i18n')
        if (key && dict[key]) el.textContent = dict[key]
      }
      for (const el of document.querySelectorAll<HTMLElement>('[data-i18n-html]')) {
        const key = el.getAttribute('data-i18n-html')
        if (key && dict[key]) el.innerHTML = dict[key]
      }
      try {
        localStorage.setItem('numen-lang', lang)
      } catch {
        // Ignore storage errors in private mode.
      }
    }

    function selectApplication(app: string) {
      document.documentElement.setAttribute('data-app', app)
      const isNumen = app === 'numen'
      for (const el of document.querySelectorAll<HTMLElement>('.app-switch-numen')) {
        el.setAttribute('aria-selected', String(isNumen))
      }
      for (const el of document.querySelectorAll<HTMLElement>('.app-switch-flashcards')) {
        el.setAttribute('aria-selected', String(!isNumen))
      }
    }

    document.getElementById('theme-toggle')?.addEventListener('click', onToggleTheme)

    document.getElementById('lang-dropdown-btn')?.addEventListener('click', (event) => {
      event.stopPropagation()
      const menu = document.getElementById('lang-menu')
      const trigger = document.getElementById('lang-dropdown-btn')
      if (!menu) return
      const willOpen = menu.hasAttribute('hidden')
      if (willOpen) {
        menu.removeAttribute('hidden')
      } else {
        menu.setAttribute('hidden', '')
      }
      if (trigger) trigger.setAttribute('aria-expanded', String(willOpen))
    })

    document.addEventListener('click', (event) => {
      const dropdown = document.getElementById('lang-dropdown')
      const menu = document.getElementById('lang-menu')
      const trigger = document.getElementById('lang-dropdown-btn')
      if (dropdown && menu && event.target instanceof Node && !dropdown.contains(event.target)) {
        menu.setAttribute('hidden', '')
        if (trigger) trigger.setAttribute('aria-expanded', 'false')
      }
    })

    for (const item of document.querySelectorAll<HTMLButtonElement>('.lang-dropdown__item')) {
      item.addEventListener('click', () => {
        const lang = item.getAttribute('data-lang')
        if (lang) setLanguage(lang)
      })
    }

    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-select-app]')) {
      btn.addEventListener('click', () => {
        const app = btn.getAttribute('data-select-app')
        if (app) selectApplication(app)
      })
    }

    try {
      const savedLang = localStorage.getItem('numen-lang')
      if (savedLang && I18N[savedLang]) setLanguage(savedLang)
    } catch {
      // Ignore storage errors in private mode.
    }
  </script>

  <script>
    const host = document.getElementById('hero-live-demo')
    const trigger = document.getElementById('demo-launch')
    const desktopQuery = window.matchMedia('(min-width: 68rem) and (hover: hover) and (pointer: fine)')

    let preloaded: Promise<typeof import('../components/mountDemoWindow')> | null = null
    let isMounted = false

    function preloadDemo() {
      if (!desktopQuery.matches || isMounted) return null
      if (!preloaded) {
        preloaded = import('../components/mountDemoWindow')
      }
      return preloaded
    }

    async function launchDemo() {
      if (!host || !desktopQuery.matches || isMounted) return
      isMounted = true
      host.setAttribute('data-loading', 'true')
      const mod = await (preloadDemo() ?? import('../components/mountDemoWindow'))
      host.removeAttribute('data-loading')
      host.setAttribute('data-live', 'true')
      mod.mountDemoWindow('#hero-live-demo')
    }

    host?.addEventListener('pointerenter', () => {
      void preloadDemo()
    })
    trigger?.addEventListener('focus', () => {
      void preloadDemo()
    })
    trigger?.addEventListener('click', () => {
      void launchDemo()
    })
  </script>

  <script>
    interface Shelf {
      version?: string
      build?: number
      commit?: string
      released?: string
      files?: readonly { name: string; url: string; size: number }[]
    }

    const takes = [...document.querySelectorAll<HTMLAnchorElement>('.take-pill[data-file]')]
    const first = takes[0]

    if (first) {
      try {
        const rawBase = import.meta.env.PUBLIC_NUMEN_DOWNLOADS_BASE?.replace(/\/+$/, '')
        const shelfBase = rawBase
          ? rawBase.endsWith('/latest')
            ? rawBase
            : `${rawBase}/latest`
          : 'https://dl.numen.md/latest'
        const manifestUrl = new URL('latest.json', `${shelfBase}/`)
        const answer = await fetch(manifestUrl, { cache: 'no-cache' })
        if (!answer.ok) throw new Error(String(answer.status))
        const shelf: Shelf = await answer.json()

        for (const take of takes) {
          const file = shelf.files?.find((one) => one.name === take.dataset['file'])
          if (!file?.url) {
            take.hidden = true
            continue
          }
          take.href = file.url
          const weight = take.querySelector('.take__weight')
          if (weight && file.size) weight.textContent = `${Math.round(file.size / 1e6)} MB`
        }

        const note = document.querySelector('.version-note')
        if (note && shelf.version) {
          const day = new Date(shelf.released ?? '')
          const when = Number.isNaN(day.valueOf())
            ? ''
            : ` — ${day.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}`
          const which = shelf.build
            ? ` (build ${shelf.build}${shelf.commit ? `, ${shelf.commit}` : ''})`
            : ''
          note.textContent = `Version ${shelf.version}${which}${when}`
          note.removeAttribute('hidden')
        }
      } catch {
        // Leave static fallback links untouched when offline.
      }
    }
  </script>
</Page>
