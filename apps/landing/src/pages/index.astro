---
/**
 * The one page: what numen is, and where to get it.
 */
import Page from '../layouts/Page.astro'
import SiteHeader from '../components/page/SiteHeader.astro'
import HeroSection from '../components/page/HeroSection.astro'
import PrivacyBand from '../components/page/PrivacyBand.astro'
import MapBand from '../components/page/MapBand.astro'
import FindingsBand from '../components/page/FindingsBand.astro'
import ReviewBand from '../components/page/ReviewBand.astro'
import DownloadBand from '../components/page/DownloadBand.astro'
import SiteFooter from '../components/page/SiteFooter.astro'

const title = 'numen — your second brain that actually remembers'
const description =
  'A local-first notebook and spaced repetition suite: linked Markdown notes, directional concept map, PDF & EPUB reader with local OCR, offline audio transcription, and an AI assistant.'
---

<Page title={title} description={description}>
  <SiteHeader />

  <main>
    <HeroSection />
    <PrivacyBand />
    <MapBand />
    <FindingsBand />
    <ReviewBand />
    <DownloadBand />
  </main>

  <SiteFooter />

  <script>
    import { initSiteControls } from '../scripts/site-controls'
    import { initDemoLaunch } from '../scripts/demo-launch'
    import { initReleaseLinks } from '../scripts/release-links'

    initSiteControls()
    initDemoLaunch()
    await initReleaseLinks()
  </script>
</Page>
