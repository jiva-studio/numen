---
/**
 * The one page: what numen is, and where to get it.
 */
import { getImage } from 'astro:assets'
import Page from '../layouts/Page.astro'
import cardsDueLight from '../assets/window-cards-due-light.webp'
import cardsDueDark from '../assets/window-cards-due-dark.webp'
import reviewLight from '../assets/window-review-light.webp'
import reviewDark from '../assets/window-review-dark.webp'
import demoWindowLight from '../assets/window-demo-light.webp'
import demoWindowDark from '../assets/window-demo-dark.webp'

const rawShelf = import.meta.env.PUBLIC_NUMEN_DOWNLOADS_BASE?.replace(/\/+$/, '')
const SHELF = rawShelf
  ? rawShelf.endsWith('/latest')
    ? rawShelf
    : `${rawShelf}/latest`
  : 'https://dl.numen.md/latest'

const BUILDS = [
  {
    id: 'macos',
    name: 'macOS',
    takes: [{ name: 'Universal', note: 'Apple Silicon & Intel (.dmg)', file: 'numen-macos.dmg' }],
  },
  {
    id: 'windows',
    name: 'Windows',
    takes: [
      { name: 'Installer', note: 'x64 (.exe)', file: 'numen-windows-setup.exe' },
      { name: 'Portable', note: 'x64 (.zip)', file: 'numen-windows-amd64.zip' },
    ],
  },
  {
    id: 'linux',
    name: 'Linux',
    takes: [
      { name: 'Debian / Ubuntu', note: '.deb', file: 'numen-linux-amd64.deb' },
      { name: 'Fedora / RHEL', note: '.rpm', file: 'numen-linux-amd64.rpm' },
      { name: 'Flatpak', note: 'any distro', file: 'numen-linux-amd64.flatpak' },
      { name: 'Snap', note: 'Ubuntu', file: 'numen-linux-amd64.snap' },
      { name: 'Archive', note: '.tar.gz', file: 'numen-linux-amd64.tar.gz' },
    ],
  },
]

const DOCS = 'https://docs.numen.md'
const FORUM = 'https://forum.numen.md'
const GITHUB = 'https://github.com/jiva-studio/numen/'
const STUDIO = 'https://jiva.studio'
const DOWNLOAD = '#get'

const FLASHCARD_SHOTS = [
  {
    id: 'cards-due',
    title: 'Due Today',
    alt: 'What is due today',
    light: cardsDueLight,
    dark: cardsDueDark,
  },
  {
    id: 'review',
    title: 'Review Session',
    alt: 'Review session',
    light: reviewLight,
    dark: reviewDark,
  },
]

const shown = { format: 'webp' as const, quality: 84 }

const [demoPlaceholderLight, demoPlaceholderDark] = await Promise.all([
  getImage({ src: demoWindowLight, ...shown }),
  getImage({ src: demoWindowDark, ...shown }),
])

const framedFlashcards = await Promise.all(
  FLASHCARD_SHOTS.map(async (shot) => ({
    ...shot,
    width: shot.light.width / 2,
    height: shot.light.height / 2,
    lit: await getImage({ src: shot.light, ...shown }),
    unlit: await getImage({ src: shot.dark, ...shown }),
  })),
)

const title = 'numen — your second brain that actually remembers'
const description =
  'A local-first notebook and spaced repetition suite: linked Markdown notes, directional concept map, PDF & EPUB reader with local OCR, offline audio transcription, and an AI assistant.'
---

<Page title={title} description={description}>
  <header class="site-header">
    <a class="brand" href="/">
      <img class="brand-logo" src="/favicon.svg" width="42" height="42" alt="" />
      <span class="brand-copy">
        <span class="brand-name">numen</span>
        <span class="brand-sub">The Second Brain</span>
      </span>
    </a>

    <nav aria-label="Primary navigation">
      <a href={DOCS} data-i18n="nav_docs">Docs</a>
      <a href={FORUM} data-i18n="nav_forum">Forum</a>
      <a href={DOWNLOAD} data-i18n="nav_download">Download</a>
      <a href={GITHUB} target="_blank" rel="noopener">GitHub</a>
    </nav>

    <div class="header-right">
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
        <span class="theme-toggle__thumb" aria-hidden="true"></span>
        <span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="4.5" />
            <path
              d="M12 2.5v2.2M12 19.3v2.2M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6"
            />
          </svg>
        </span>
        <span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" />
          </svg>
        </span>
      </button>

      <div class="lang-dropdown" id="lang-dropdown">
        <button
          type="button"
          class="lang-dropdown__btn"
          id="lang-dropdown-btn"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path
              d="M3.6 9h16.8M3.6 15h16.8M12 3a14.5 14.5 0 0 0 0 18M12 3a14.5 14.5 0 0 1 0 18"
            />
          </svg>
          <span id="lang-current-label">EN</span>
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M4.5 6.5 8 10l3.5-3.5" />
          </svg>
        </button>

        <div class="lang-dropdown__menu" id="lang-menu" role="listbox" hidden>
          <button
            type="button"
            class="lang-dropdown__item"
            data-lang="en"
            aria-selected="true"
          >
            <span>English</span>
            <span class="lang-dropdown__code">EN</span>
          </button>
          <button
            type="button"
            class="lang-dropdown__item"
            data-lang="ru"
            aria-selected="false"
          >
            <span>Русский</span>
            <span class="lang-dropdown__code">RU</span>
          </button>
          <button
            type="button"
            class="lang-dropdown__item"
            data-lang="sr"
            aria-selected="false"
          >
            <span>Srpski</span>
            <span class="lang-dropdown__code">SR</span>
          </button>
        </div>
      </div>

      <a class="button button-small" href={DOWNLOAD} data-i18n="nav_download">Download</a>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="hero" id="top">
      <div class="container">
        <div class="hero-top">
          <div class="hero-copy">
            <p class="eyebrow">
              <span></span>
              <b data-i18n="hero_eyebrow">Your second brain that actually remembers</b>
            </p>
            <!-- avoid-ai-design-ignore: SD5 -->
            <h1 data-i18n-html="hero_title">Your notes, joined <em>the way you think.</em></h1>
            <p class="hero-lede" data-i18n="hero_lead">
              Markdown notes, a directional concept map, PDF &amp; EPUB reader with local OCR,
              offline audio transcription, AI assistant, and spaced repetition.
            </p>
            <div class="hero-actions">
              <a class="button" href={DOWNLOAD}>
                <span data-i18n="nav_download">Download</span>
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M8 2.5v8.5M4.5 7.8 8 11.3l3.5-3.5M3 13.5h10" />
                </svg>
              </a>
              <a class="button-secondary" href={GITHUB} target="_blank" rel="noopener">
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path
                    d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
                  />
                </svg>
                <span>GitHub</span>
              </a>
            </div>
          </div>

          <div class="suite-dossier" role="tablist" aria-label="Applications">
            <div class="suite-dossier__head">
              <span data-i18n="suite_head">Build knowledge, then keep it</span>
            </div>
            <div class="suite-tabs">
              <button
                type="button"
                class="suite-tab app-switch-numen"
                role="tab"
                aria-selected="true"
                data-select-app="numen"
              >
                <div class="suite-tab__info">
                  <strong>Numen</strong>
                  <small data-i18n="app1_desc">
                    Build your knowledge: linked notes, directional map, PDF/EPUB with OCR, audio
                    transcription, and AI assistant.
                  </small>
                </div>
              </button>

              <button
                type="button"
                class="suite-tab app-switch-flashcards"
                role="tab"
                aria-selected="false"
                data-select-app="flashcards"
              >
                <div class="suite-tab__info">
                  <strong>Numen Flashcards</strong>
                  <small data-i18n="app2_desc">
                    Retain what matters: a dedicated desktop app for daily spaced repetition, FSRS
                    scheduling, and workload forecasting.
                  </small>
                </div>
              </button>
            </div>
          </div>
        </div>

        <!-- Framed Window Stage for Numen -->
        <div class="stage-wrap for-numen">
          <div class="window-artifact">
            <div class="window-titlebar">
              <div class="window-lights"><span></span><span></span><span></span></div>
              <div class="window-titlebar__title"><strong>numen</strong> — ~/Vault/Physics</div>
              <span></span>
            </div>

            <div id="hero-live-demo">
              <img
                class="img-light hero-live-demo__placeholder"
                src={demoPlaceholderLight.src}
                width={demoWindowLight.width / 2}
                height={demoWindowLight.height / 2}
                alt="Numen workspace"
                fetchpriority="high"
              />
              <img
                class="img-dark hero-live-demo__placeholder"
                src={demoPlaceholderDark.src}
                width={demoWindowDark.width / 2}
                height={demoWindowDark.height / 2}
                alt="Numen workspace"
                fetchpriority="high"
              />
              <button type="button" class="demo-launch" id="demo-launch">
                <span class="demo-launch__pill">
                  <span class="demo-launch__badge">
                    <svg viewBox="0 0 16 16" aria-hidden="true">
                      <path d="M5 3.5v9l7-4.5-7-4.5Z" />
                    </svg>
                  </span>
                  <span class="demo-launch__copy">
                    <strong data-i18n="demo_try_title">Try interactive demo</strong>
                    <small data-i18n="demo_try_sub">Click to explore notes, map, PDF &amp; AI</small>
                  </span>
                </span>
              </button>
            </div>
          </div>
        </div>

        <!-- Framed Window Stage for Numen Flashcards -->
        <div class="stage-wrap for-flashcards">
          <div class="flashcards-pair">
            {
              framedFlashcards.map((shot) => (
                <div class="window-artifact">
                  <div class="window-titlebar">
                    <div class="window-lights">
                      <span />
                      <span />
                      <span />
                    </div>
                    <div class="window-titlebar__title">
                      <strong>numen-flashcards</strong> — {shot.title}
                    </div>
                    <span />
                  </div>
                  <img
                    class="img-light"
                    src={shot.lit.src}
                    width={shot.width}
                    height={shot.height}
                    alt={shot.alt}
                  />
                  <img
                    class="img-dark"
                    src={shot.unlit.src}
                    width={shot.width}
                    height={shot.height}
                    alt={shot.alt}
                  />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Band 1: Forest Band — Privacy-First & Local-First -->
    <section class="problem band">
      <div class="container">
        <div class="problem-layout">
          <div class="problem-copy">
            <p class="section-kicker" data-i18n="yours_eyebrow">Privacy-First &amp; Local-First</p>
            <h2 data-i18n="yours_title">Your thoughts are yours.</h2>
            <p data-i18n="yours_lede">
              No account, no cloud lock-in, and no proprietary database. Your vault is an ordinary
              folder of open Markdown files on your disk — backed by local AI models that run on
              your own hardware.
            </p>
          </div>

          <div class="problem-matrix">
            <article class="problem-cell">
              <h3 data-i18n="yours_f1_t">Open Markdown files</h3>
              <p data-i18n="yours_f1_p">
                Plain .md files in your own folders. Open them in any editor, track them in Git,
                and keep them for decades without lock-in.
              </p>
            </article>
            <article class="problem-cell">
              <h3 data-i18n="yours_f2_t">Local on-device models</h3>
              <p data-i18n="yours_f2_p">
                Speech transcription, PDF OCR, and semantic search embeddings run locally via ONNX
                on your machine — zero cloud uploads.
              </p>
            </article>
            <article class="problem-cell">
              <h3 data-i18n="yours_f3_t">Private by default</h3>
              <p data-i18n="yours_f3_p">
                No sign-up or telemetry. Point Numen at an existing folder of notes and books and
                work completely offline.
              </p>
            </article>
            <article class="problem-cell">
              <h3 data-i18n="yours_f4_t">Open source &amp; your own sync</h3>
              <p data-i18n="yours_f4_p">
                Inspect every line of code on GitHub (AGPL-3.0) and sync your folder with Git,
                iCloud, Dropbox, or Syncthing.
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- Band 2: The Map -->
    <section class="band" id="map">
      <div class="container">
        <div class="section-head">
          <p class="section-kicker" data-i18n="map_eyebrow">The Map</p>
          <h2 data-i18n="map_title">A map with real structure.</h2>
          <p data-i18n="map_lede_2">
            Links carry direction — hierarchy above, details below, or lateral jumps across topics —
            so your graph never turns into a tangled hairball.
          </p>
        </div>

        <div class="cards-grid-3">
          <article class="u-card">
            <h3 data-i18n="map_f1_t">Focused local graph</h3>
            <p data-i18n="map_f1_p">
              Centered on your active note and its direct neighbors, keeping 10,000 notes as clear
              as ten.
            </p>
          </article>
          <article class="u-card">
            <h3 data-i18n="map_f2_t">Drag to link &amp; create</h3>
            <p data-i18n="map_f2_p">
              Drag a line between notes to connect them, or drop it into empty space to create a new
              note on the spot.
            </p>
          </article>
          <article class="u-card">
            <h3 data-i18n="map_f3_t">Split-pane workspace</h3>
            <p data-i18n="map_f3_p">
              Keep the interactive map, your Markdown editor, a PDF book, and the AI assistant open
              side by side.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Band 3: Any type of data in your vault -->
    <section class="findings band">
      <div class="container">
        <div class="section-head">
          <p class="section-kicker" data-i18n="cap_eyebrow">Books, Audio &amp; AI</p>
          <h2 data-i18n="cap_title">Any type of data in your vault.</h2>
          <p data-i18n="cap_lede">
            Drop books, scanned papers, and lecture recordings into your folder. Numen recognizes
            text, transcribes speech, and indexes everything locally.
          </p>
        </div>

        <div class="cards-grid-2">
          <article class="u-card">
            <span class="u-card__tag" data-i18n="row1_tag">PDF, EPUB &amp; local OCR</span>
            <h3 data-i18n="books_title">Read and search books alongside your notes</h3>
            <p data-i18n="books_f2_p">
              Open PDFs and EPUBs right beside your editor. Scanned books pass through local OCR so
              search jumps straight to the exact page and highlights the passage.
            </p>
          </article>

          <article class="u-card">
            <span class="u-card__tag" data-i18n="row2_tag">Offline transcription</span>
            <h3 data-i18n="rec_title">Turn lectures and voice notes into timestamped text</h3>
            <p data-i18n="rec_f2_p">
              Audio and video files are transcribed on your machine with zero cloud uploads. Click
              any line in the transcript to play from that exact second.
            </p>
          </article>

          <article class="u-card">
            <span class="u-card__tag" data-i18n="row3_tag">Hybrid semantic search</span>
            <h3 data-i18n="finding_title">Search by exact words or by meaning</h3>
            <p data-i18n="finding_f2_p">
              Type a keyword or describe the idea in your own words to find the right passage across
              all your notes, books, and transcripts.
            </p>
          </article>

          <article class="u-card">
            <span class="u-card__tag" data-i18n="row4_tag">Grounded AI assistant</span>
            <h3 data-i18n="agent_title">Ask questions across your own library</h3>
            <p data-i18n="agent_f3_p">
              Compare sources, find gaps in your notes, or draft new notes with full visibility into
              every file read or modified.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Band 4: Spaced Repetition -->
    <section class="band" id="review">
      <div class="container">
        <div class="section-head">
          <p class="section-kicker" data-i18n="cards_eyebrow">
            Spaced Repetition — Numen Flashcards
          </p>
          <h2 data-i18n="cards_title">Turn notes into long-term memory.</h2>
          <p data-i18n="cards_lede">
            Build flashcards in Markdown while you read, then review them in Numen Flashcards — a
            dedicated desktop app for focused daily sessions.
          </p>
        </div>

        <div class="cards-grid-3">
          <article class="u-card">
            <h3 data-i18n="review_f1_t">Daily time budget</h3>
            <p data-i18n="review_f1_p">
              Set a daily time target (e.g. 25 minutes), a retention goal, or an exam date — the
              FSRS scheduler builds your queue automatically.
            </p>
          </article>
          <article class="u-card">
            <h3 data-i18n="review_f2_t">Workload forecast</h3>
            <p data-i18n="review_f2_p">
              Preview how many cards each pace requires per day and see when your backlog clears
              before committing to a schedule.
            </p>
          </article>
          <article class="u-card">
            <h3 data-i18n="review_f3_t">Instant source context</h3>
            <p data-i18n="review_f3_p">
              Open the source note or book page right beside the card, or ask the AI assistant to
              explain an answer during review.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Band 5: Deep Dark Download Band (#get) -->
    <section class="evidence band" id="get">
      <div class="container">
        <div class="evidence-grid">
          <div class="evidence-copy">
            <p class="section-kicker" data-i18n="nav_download">Download</p>
            <h2 data-i18n="close_title">Download Numen.</h2>
            <p data-i18n="close_lede">
              Free during the alpha for macOS, Windows, and Linux. Includes both Numen and Numen
              Flashcards.
            </p>
          </div>

          <div class="resource-action">
            {
              BUILDS.map((build) => (
                <div class="shelf-row">
                  <div class="shelf-what">{build.name}</div>
                  <div class="shelf-takes">
                    {build.takes.map((take) => (
                      <a
                        class="take-pill"
                        href={`${SHELF}/${take.file}`}
                        data-file={take.file}
                        download
                      >
                        <b>{take.name}</b>
                        <span>{take.note}</span>
                        <em class="take__weight" />
                      </a>
                    ))}
                  </div>
                </div>
              ))
            }

            <p class="version-note" hidden></p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <a class="brand" href="/">
      <img class="brand-logo" src="/favicon.svg" width="28" height="28" alt="" />
      <span>numen</span>
    </a>
    <p>
      © 2026 <a href={STUDIO} target="_blank" rel="noopener">Jiva Studio</a>. All rights reserved.
    </p>
    <div>
      <a href={DOCS} data-i18n="nav_docs">Docs</a>
      <a href={FORUM} data-i18n="nav_forum">Forum</a>
      <a href={GITHUB} target="_blank" rel="noopener">GitHub</a>
      <a href={DOWNLOAD} data-i18n="nav_download">Download</a>
    </div>
  </footer>

  <script>
    const I18N: Record<string, Record<string, string>> = {
      en: {
        nav_docs: 'Docs',
        nav_forum: 'Forum',
        nav_download: 'Download',
        hero_eyebrow: 'Your second brain that actually remembers',
        hero_title: 'Your notes, joined <em>the way you think.</em>',
        hero_lead:
          'Markdown notes, a directional concept map, PDF & EPUB reader with local OCR, offline audio transcription, AI assistant, and spaced repetition.',
        suite_head: 'Build knowledge, then keep it',
        app1_desc:
          'Build your knowledge: linked notes, directional map, PDF/EPUB with OCR, audio transcription, and AI assistant.',
        app2_desc:
          'Retain what matters: a dedicated desktop app for daily spaced repetition, FSRS scheduling, and workload forecasting.',
        demo_try_title: 'Try interactive demo',
        demo_try_sub: 'Click to explore notes, map, PDF & AI',
        tab_files: 'Files',
        tab_editor: 'Writing',
        tab_graph: 'The map',
        tab_search: 'Search',
        tab_agent: 'The assistant',
        tab_audio: 'Recordings',
        tab_ocr: 'Books',
        tab_deck: 'Decks',
        yours_eyebrow: 'Privacy-First & Local-First',
        yours_title: 'Your thoughts are yours.',
        yours_lede:
          'No account, no cloud lock-in, and no proprietary database. Your vault is an ordinary folder of open Markdown files on your disk — backed by local AI models that run on your own hardware.',
        yours_f1_t: 'Open Markdown files',
        yours_f1_p:
          'Plain .md files in your own folders. Open them in any editor, track them in Git, and keep them for decades without lock-in.',
        yours_f2_t: 'Local on-device models',
        yours_f2_p:
          'Speech transcription, PDF OCR, and semantic search embeddings run locally via ONNX on your machine — zero cloud uploads.',
        yours_f3_t: 'Private by default',
        yours_f3_p:
          'No sign-up or telemetry. Point Numen at an existing folder of notes and books and work completely offline.',
        yours_f4_t: 'Open source & your own sync',
        yours_f4_p:
          'Inspect every line of code on GitHub (AGPL-3.0) and sync your folder with Git, iCloud, Dropbox, or Syncthing.',
        map_eyebrow: 'The Map',
        map_title: 'A map with real structure.',
        map_lede_2:
          'Links carry direction — hierarchy above, details below, or lateral jumps across topics — so your graph never turns into a tangled hairball.',
        map_f1_t: 'Focused local graph',
        map_f1_p:
          'Centered on your active note and its direct neighbors, keeping 10,000 notes as clear as ten.',
        map_f2_t: 'Drag to link & create',
        map_f2_p:
          'Drag a line between notes to connect them, or drop it into empty space to create a new note on the spot.',
