---
/**
 * The page of one plugin: a compact header with its facts, then Overview (README and screenshots),
 * Scorecard (checks, permissions, settings, commands, downloads, tests) and Changelog as tabs.
 */
import { getCollection, render, type CollectionEntry } from 'astro:content'
import Page from '../../layouts/Page.astro'
import SiteHeader from '../../components/page/SiteHeader.astro'
import SiteFooter from '../../components/page/SiteFooter.astro'
import PluginScreenshots from '../../components/plugins/PluginScreenshots.astro'
import PluginScorecard from '../../components/plugins/PluginScorecard.astro'
import PluginChangelog from '../../components/plugins/PluginChangelog.astro'
import PluginHeader from '../../components/plugins/PluginHeader.astro'
import type { CatalogPlugin } from '../../components/plugins/catalog'
import '../../styles/plugins.css'

export async function getStaticPaths() {
  const entries = await getCollection('plugins')
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }))
}

interface Props {
  entry: CollectionEntry<'plugins'>
}

const { entry } = Astro.props
const plugin = entry.data as CatalogPlugin
const { Content } = entry.rendered ? await render(entry) : { Content: null }

const title = `${plugin.name} — numen plugins`
const description = plugin.readme?.intro || plugin.description
const tabs = [
  { id: 'overview', key: 'plugin_tab_overview', text: 'Overview' },
  { id: 'scorecard', key: 'plugin_tab_scorecard', text: 'Scorecard' },
  { id: 'changelog', key: 'plugin_tab_changelog', text: 'Changelog' },
]
---

<Page title={title} description={description}>
  <SiteHeader />

  <main class="band plugin-page">
    <div class="container">
      <PluginHeader plugin={plugin} />

      <div class="plugin-tabs" role="tablist">
        {
          tabs.map((tab, index) => (
            <button
              type="button"
              role="tab"
              id={`tab-${tab.id}`}
              aria-controls={`panel-${tab.id}`}
              aria-selected={String(index === 0)}
              tabindex={index === 0 ? 0 : -1}
              data-plugin-tab
              data-i18n={tab.key}
            >
              {tab.text}
            </button>
          ))
        }
      </div>

      <section class="plugin-panel" id="panel-overview" role="tabpanel" aria-labelledby="tab-overview">
        {
          plugin.isPaid && (
            <p class="plugin-muted" data-i18n="plugin_paid_note">
              This plugin is paid. You buy it in the Numen app.
            </p>
          )
        }
        <PluginScreenshots plugin={plugin} />
        {
          Content ? (
            <div class="plugin-prose">
              <Content />
            </div>
          ) : (
            <p class="plugin-muted" data-i18n="plugin_no_readme">
              This plugin has no README.
            </p>
          )
        }
      </section>

      <section class="plugin-panel" id="panel-scorecard" role="tabpanel" aria-labelledby="tab-scorecard">
        <PluginScorecard plugin={plugin} />
      </section>

      <section class="plugin-panel" id="panel-changelog" role="tabpanel" aria-labelledby="tab-changelog">
        <PluginChangelog plugin={plugin} />
      </section>
    </div>
  </main>

  <SiteFooter />

  <script>
    import { initSiteControls } from '../../scripts/site-controls'
    import { initPluginTabs } from '../../scripts/plugin-tabs'

    initSiteControls()
    initPluginTabs()
  </script>
</Page>
