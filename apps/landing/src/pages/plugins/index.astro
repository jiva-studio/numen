---
/**
 * The plugin catalog: every plugin of the registry as a card, with the search and the filters over
 * them.
 */
import { getCollection } from 'astro:content'
import Page from '../../layouts/Page.astro'
import SiteHeader from '../../components/page/SiteHeader.astro'
import SiteFooter from '../../components/page/SiteFooter.astro'
import PluginCard from '../../components/plugins/PluginCard.astro'
import PluginFilters from '../../components/plugins/PluginFilters.vue'
import {
  APP_NAMES,
  type CatalogPlugin,
  getCategoryName,
  listCategories,
} from '../../components/plugins/catalog'
import '../../styles/plugins.css'

const plugins = (await getCollection('plugins'))
  .map((entry) => entry.data as CatalogPlugin)
  .sort((a, b) => a.name.localeCompare(b.name))
const categories = listCategories(plugins).map((id) => ({ id, text: getCategoryName(id) }))
const apps = Object.entries(APP_NAMES).map(([id, text]) => ({ id, text }))

const title = 'Plugins — numen'
const description =
  'Plugins for Numen and Numen Flashcards: what each one does, what it can access, and how it is tested.'
---

<Page title={title} description={description}>
  <SiteHeader />

  <main class="band plugin-band">
    <div class="container">
      <header class="plugin-intro">
        <h1 data-i18n="plugins_title">Plugins for Numen</h1>
        <p data-i18n="plugins_lede">What each plugin does, what it can access, and how it is tested.</p>
      </header>

      {/* Client only: hydrating a server-drawn Teleport to body takes the page apart. */}
      <div class="plugin-filters-slot">
        <PluginFilters client:only="vue" categories={categories} apps={apps} />
      </div>

      <ul class="plugin-grid">
        {plugins.map((plugin) => <PluginCard plugin={plugin} />)}
      </ul>
      <p class="plugin-muted" data-plugin-empty data-i18n="plugins_none" hidden>No plugin matches.</p>
    </div>
  </main>

  <SiteFooter />

  <script>
    import { initSiteControls } from '../../scripts/site-controls'

    initSiteControls()
  </script>
</Page>
