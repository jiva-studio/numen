{
  "name": "@numen/e2e-desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "End-to-end tests for the desktop application",
  "scripts": {
    "test": "node scripts/run-offline.mjs",
    "test:headed": "playwright test --headed",
    "test:video": "PLAYWRIGHT_VIDEO=1 node scripts/run-offline.mjs",
    "test:report": "playwright show-report",
    "test:flashcards": "node scripts/run-offline.mjs -c playwright.flashcards.config.ts"
  }
}
