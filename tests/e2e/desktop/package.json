{
  "name": "@numen/e2e-desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "End-to-end tests for the desktop application",
  "scripts": {
    "test": "node scripts/run-offline.mjs",
    "test:headed": "playwright test --headed",
    "test:video": "PLAYWRIGHT_VIDEO=1 node scripts/run-offline.mjs",
    "test:report": "playwright show-report",
    "test:flashcards": "node scripts/run-offline.mjs -c playwright.flashcards.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && node scripts/check-shards.mjs",
    "shards:check": "node scripts/check-shards.mjs",
    "shards:measure": "node scripts/measure-shards.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.1",
    "globals": "^17.14.0",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
