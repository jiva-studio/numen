{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "tests/**/*",
    "flashcards/**/*",
    "scripts/**/*",
    "playwright.config.ts",
    "playwright.flashcards.config.ts"
  ]
}
